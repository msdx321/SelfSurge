[Rule]
# Converted to rewrite: URL-REGEX, "^https:\/\/a\.line\.me\/er\/lads\/v\d\/ei\?", REJECT-IMG
# Converted to rewrite: URL-REGEX, "^https:\/\/a\.line\.me\/er\/l.*\/v\d\/event\/image", REJECT-IMG
URL-REGEX, "^https:\/\/a\.line\.me\/lass\/api\/v\d\/ads$", REJECT-DROP
URL-REGEX, "^https:\/\/a\.line\.me\/oa\/v\d\/e$", REJECT-DROP
URL-REGEX, "^https:\/\/a\.line\.me\/cs\/v\d\/oa$", REJECT-DROP
URL-REGEX, "^https:\/\/w\.line\.me\/adp\/api\/ad\/v\d\/", REJECT-DROP
URL-REGEX, "^https:\/\/crs-event\.line\.me\/v\d\/imp", REJECT-DROP
URL-REGEX, "^https:\/\/sch\.line\.me\/api\/v\d\/ads$", REJECT-DROP
URL-REGEX, "^https:\/\/uts-front\.line-apps\.com\/event$", REJECT-DROP
URL-REGEX, "^https:\/\/uts-front\.line-apps\.com\/settings$", REJECT-DROP
URL-REGEX, "^https:\/\/obs\.line-scdn\.net\/0h[a-zA-Z0-9_-]{50}[a-zA-Z0-9_-]*", REJECT-DROP
URL-REGEX, "^https:\/\/obs\.line-scdn\.net\/0h.+\/(o|m)\d+x\d+$", REJECT-DROP
URL-REGEX, "^https:\/\/obs\.line-scdn\.net\/0hGH\d", REJECT-DROP
URL-REGEX, "^https:\/\/obs\.line-scdn\.net\/0h.+\/\d+p\.mp4$", REJECT-DROP
# Converted to rewrite: URL-REGEX, "^https:\/\/obs\.line-scdn\.net\/r\/linecrs\/.+\/m180x180$", REJECT-IMG
# Converted to rewrite: URL-REGEX, "^https:\/\/ec-bot-obs\.line-scdn\.net\/0h[0-9a-zA-Z_-]{50}[0-9a-zA-Z_-]*", REJECT-IMG
# Converted to rewrite: URL-REGEX, "^https:\/\/d\.line-scdn\.net\/lcp-prod-photo\/20.+\.(jpg|jpeg|png)", REJECT-IMG
# Converted to rewrite: URL-REGEX, "^https:\/\/web-mmap-pay\.line-apps\.com\/tw\/liff\/campaign\/v\d\/aggregate\/ad\/banner\/", REJECT-IMG
URL-REGEX, "^https:\/\/scdn\.line-apps\.com\/lan\/image\/line\/bannerImageEvent\/", REJECT-DROP
URL-REGEX, "^https:\/\/scdn\.line-apps\.com\/lan\/document\/pageEvent\/line\/ios\/", REJECT-DROP

[URL Rewrite]
^https:\/\/gw\.line\.naver\.jp\/ext\/lgfp\/lad\/v\d$ _ reject
^https:\/\/gw\.line\.naver\.jp\/lass\/api\/v\d\/ads$ _ reject
^https:\/\/gw\.line\.naver\.jp\/tr\/event$ _ reject
^https:\/\/legy\.line-apps\.com:443\/ext\/lgfp\/lad\/v\d$ _ reject
^https:\/\/legy\.line-apps\.com:443\/ext\/smartch\/banner\/sch\/v\d$ _ reject
^https:\/\/legy\.line-apps\.com\/line\.gcs\.GcsModuleService\/GetModulesByModuleIds$ _ reject
^https:\/\/legy\.line-apps\.com:443\/tr\/event$ _ reject
^https:\/\/lan\.line\.me\/v\d\/line\/ios _ reject
^https:\/\/buy\.line\.me\/api\/graphql\?variables _ reject
^https:\/\/nelo2-col\.linecorp\.com\/_store$ _ reject
^https:\/\/cix\.line-apps\.com\/R\d\? _ reject
^https:\/\/ad\.line-scdn\.net\/0h _ reject
^https:\/\/static\.line-scdn\.net\/ad-sdk\/ _ reject
^https:\/\/scdn\.line-apps\.com\/appresources\/moretab\/list\.json _ reject

[Map Local]
"^https:\/\/a\.line\.me\/er\/lads\/v\d\/ei\?" data-type=tiny-gif status-code=200
"^https:\/\/a\.line\.me\/er\/l.*\/v\d\/event\/image" data-type=tiny-gif status-code=200
"^https:\/\/obs\.line-scdn\.net\/r\/linecrs\/.+\/m180x180$" data-type=tiny-gif status-code=200
"^https:\/\/ec-bot-obs\.line-scdn\.net\/0h[0-9a-zA-Z_-]{50}[0-9a-zA-Z_-]*" data-type=tiny-gif status-code=200
"^https:\/\/d\.line-scdn\.net\/lcp-prod-photo\/20.+\.(jpg|jpeg|png)" data-type=tiny-gif status-code=200
"^https:\/\/web-mmap-pay\.line-apps\.com\/tw\/liff\/campaign\/v\d\/aggregate\/ad\/banner\/" data-type=tiny-gif status-code=200

[MITM]
hostname = %APPEND% a.line.me, ad.line-scdn.net, w.line.me, gw.line.naver.jp, lan.line.me, buy.line.me, crs-event.line.me, obs.line-scdn.net, d.line-scdn.net, scdn.line-apps.com, sch.line.me, static.line-scdn.net, nelo2-col.linecorp.com, uts-front.line-apps.com, cix.line-apps.com, legy.line-apps.com, ec-bot-obs.line-scdn.net
