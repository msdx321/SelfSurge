#!name=拼多多去广告
#!desc=移除开屏广告、底栏多多视频、会场入口、聊天页面精选推荐及推广，精简首页和个人中心。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id1044283059
#!author=ZenmoFeiShi[https://github.com/ZenmoFeiShi], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PinDuoDuo.png
#!date=2026-07-11 20:21:39
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/PinDuoDuo_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
AND, ((URL-REGEX, "^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/d(\d)?"), (USER-AGENT, "*com.xunmeng.pinduoduo*")), REJECT-DROP
AND, ((URL-REGEX, "^http:\/\/\[[0-9a-fA-F:]+\]\/d(\d)?\?"), (USER-AGENT, "*com.xunmeng.pinduoduo*")), REJECT-DROP
AND, ((DOMAIN, api.pinduoduo.com), (PROTOCOL, QUIC)), REJECT-DROP
DOMAIN, titan.pinduoduo.com, REJECT-DROP
DOMAIN, xg.pinduoduo.com, REJECT-DROP
DOMAIN, cdl-1.pddpic.com, REJECT-DROP
DOMAIN, titan.pinduoduo.com, REJECT-DROP
DOMAIN, cdl-p2.pddpic.com, REJECT-DROP
DOMAIN, cd-1.pddpic.com, REJECT-DROP
DOMAIN, apm.pinduoduo.com, REJECT-DROP
DOMAIN, th-b.pinduoduo.com, REJECT-DROP
DOMAIN, ta.pinduoduo.com, REJECT-DROP
DOMAIN, th.pinduoduo.com, REJECT-DROP
DOMAIN, th-a.pinduoduo.com, REJECT-DROP
DOMAIN, ta-a.pinduoduo.com, REJECT-DROP
DOMAIN, meta.pinduoduo.com, REJECT-DROP
DOMAIN, apm-a.pinduoduo.com, REJECT-DROP

[Map Local]
^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/unrated_order_for_unreceived_tab\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/query_order_list_tabs_element\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/aquarius\/hungary\/global\/homepage\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/order_express_group\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/search_hotquery\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/zaire_biz\/chat\/resource\/get_list_data\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/new_chat_group\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/alexa\/goods\/back_up\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/personal\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/brand-olay\/goods_detail\/bybt_guide\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/engels\/reviews\/require\/append\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/my_order_group\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/likes\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/phantom\/gbdbpdv\/extra\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/manufacturer\/cross\/shortcut\/list\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/dunkirk\/liveactivity\/push\/create\/url\/report\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/growth\/nagato\/app\/index\/gather\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/engels\/wait\/receive\/review\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/buffon\/nasus\/recommend\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v2\/query\/goods_detail_with_tags\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? 'reduce [["result","dy_module","irregular_banner_dy"],["result","icon_set"],["result","search_bar_hot_query"],["result","dy_module","irregular_banner_dy"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? '.result.bottom_tabs? |= map(select(.link | IN("index.html", "chat_list.html", "personal.html"))) | .result.buffer_bottom_tabs? |= map(select(.link | IN("index.html", "chat_list.html", "personal.html"))) | .result.all_top_opts |= map(del(.selected_image, .image, .height, .width))'
http-response-jq ^https:\/\/api\.pinduoduo\.com\/search\? 'reduce [["expansion"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub\? 'reduce [["monthly_card_entrance"],["personal_center_style_v2_vo"],["icon_set","icons"],["icon_set","top_personal_icons"],["personal_banner"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/api\.pinduoduo\.com\/api\/oak\/integration\/render\? 'reduce [["bottom_section_list"],["ui","bottom_section"],["ui","live_section","float_info"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/order_detail_group\? 'reduce [["data","goods_list"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/api\.pinduoduo\.com\/order\/ 'reduce [["marketing_banner_vo"],["shipping","banner_above_recommend"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/order_list_v4\? '.orders |= map(.order_buttons |= map(del(.order_growth_tip)))'

[Script]
移除扫码取件页面商品推荐及弹窗 = type=http-response,pattern=^https:\/\/m\.pinduoduo\.net\/mdkd\/package\?from_app_scan,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/PinDuoDuo/PinDuoDuo_remove_ads.js,requires-body=true

[MITM]
hostname = %APPEND% api.pinduoduo.com, m.pinduoduo.net
