#!name=YouTube去广告
#!desc=移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底栏的Shorts按钮和上传按钮，增加画中画及字幕翻译功能。移除YouTube Music底栏的上传、选段和升级按钮，增加歌词翻译，支持二者的后台播放。此插件需要启用MitM over HTTP/2和QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id544007664
#!author=Maasea[https://github.com/Maasea], VirgilClyne[https://github.com/VirgilClyne], Choler[https://github.com/Choler], DivineEngine[https://github.com/DivineEngine], app2smile[https://github.com/app2smile]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
#!date=2026-07-23 03:47:41
#!arguments=blockUpload:false,blockShorts:false,blockImmersive:false,captionLang:zh-Hans,debug:false
#!arguments-desc=Loon 选项与策略已转为 Surge 自由输入；脚本参数按同名字段传入，具体格式见模块注释；enable 字段为 false 时脚本需立即退出。

# Source: https://kelee.one/Tool/Loon/Lpx/YouTube_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

# Surge 参数 blockUpload：默认 false；可选 false | true；隐藏上传按钮；用于隐藏YouTube底栏的上传按钮
# Surge 参数 blockShorts：默认 false；可选 false | true；隐藏Shorts按钮；用于隐藏YouTube底栏的Shorts按钮
# Surge 参数 blockImmersive：默认 false；可选 false | true；隐藏选段按钮；用于隐藏YouTube Music底栏的选段按钮
# Surge 参数 captionLang：默认 zh-Hans；可选 zh-Hans | zh-Hant | ja | ko | en | off；字幕翻译语言；需要把YouTube字幕翻译翻译为何种语言
# Surge 参数 debug：默认 false；可选 false | true；启用调试模式；此插件的调试模式

[Script]
YouTube去广告 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/YouTube/YouTube_remove_ads/YouTube_remove_ads_response.js,requires-body=true,binary-body-mode=true,argument="{\"blockUpload\":{{{blockUpload}}},\"blockShorts\":{{{blockShorts}}},\"blockImmersive\":{{{blockImmersive}}},\"captionLang\":\"{{{captionLang}}}\",\"debug\":{{{debug}}}}"
请求初始化 = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js,requires-body=true,binary-body-mode=true,argument="{\"captionLang\":\"{{{captionLang}}}\"}"
请求日志事件 = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js,requires-body=true,binary-body-mode=true,argument="{\"blockUpload\":{{{blockUpload}}},\"blockShorts\":{{{blockShorts}}},\"blockImmersive\":{{{blockImmersive}}},\"captionLang\":\"{{{captionLang}}}\",\"debug\":{{{debug}}}}"

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
