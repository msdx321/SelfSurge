[Script]
App Store API = type=http-request,pattern=^https:\/\/apple-api\.com,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/IPATool/AppStoreAPI.js,requires-body=true
安装器 = type=http-request,pattern=^https:\/\/xiaobai\.app,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/IPATool/Installer.js

[MITM]
hostname = %APPEND% apple-api.com, xiaobai.app
