#!name=Telegram重定向
#!desc=适用于安装了多个不同Telegram客户端的用户，用于在指定客户端中打开公开或私有群组及频道的Telegram短链。
#!openUrl=https://apps.apple.com/app/id1127750481
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Telegram.png
#!date=2026-08-03 15:27:21

#!arguments=app:tg
#!arguments-desc=Loon 选项已转为自由输入；可选值见模块注释；enable 值作为脚本最后一个参数传入。
# Surge 参数 app：默认 tg；可选 tg | sg | turrit | ime | ng | lingo；客户端；指定跳转的客户端

[URL Rewrite]
^https:\/\/t\.me\/([A-Za-z][A-Za-z0-9_]{3,30}[A-Za-z0-9])\/?$ {{{app}}}://resolve?domain=$1 307
^https:\/\/t\.me\/\+([A-Za-z0-9_-]+)\/?$ {{{app}}}://join?invite=$1 307

[MITM]
hostname = %APPEND% t.me
