#!name=优酷视频去广告
#!desc=移除开屏广告、视频广告、信息流广告。其余广告由于请求已加密，故无法移除。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id336141475
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], RuCu6[https://github.com/RuCu6]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouKu_Video.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/YouKu_Video_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN, push.m.youku.com, DIRECT
DOMAIN, un-acs.youku.com, DIRECT
DOMAIN, dorangesource.alicdn.com, DIRECT
DOMAIN, h-adashx.ut.taobao.com, REJECT-DROP
DOMAIN, adx-core.youku.com, REJECT-DROP
DOMAIN, adx-open-service.youku.com, REJECT-DROP
DOMAIN, yk-ssp.ad.youku.com, REJECT-DROP
DOMAIN, cad.youku.com, REJECT-DROP
DOMAIN, ykad-data.youku.com, REJECT-DROP
DOMAIN, yk-ssp.ad.youku.com, REJECT-DROP
DOMAIN, amdc.m.youku.com, REJECT-DROP
DOMAIN, cad.youku.com, REJECT-DROP
DOMAIN, nbsdk-baichuan.alicdn.com, REJECT-DROP
DOMAIN, youku-crm-product.youku.com, REJECT-DROP
DOMAIN, dr-danmu.youku.com, REJECT-DROP
DOMAIN, group-ssl-danmu-ori.youku.com, REJECT-DROP
DOMAIN, m.atm.youku.com, REJECT-DROP
DOMAIN, mc.atm.youku.com, REJECT-DROP
DOMAIN, vali-g1.cp31.ott.cibntv.net, REJECT-DROP
DOMAIN, vali-ugc.cp31.ott.cibntv.net, REJECT-DROP
DOMAIN-SUFFIX, iyes.youku.com, REJECT-DROP
DOMAIN, adsmind.ugdtimg.com, REJECT-DROP
DOMAIN, pre-acs.youku.com, REJECT-DROP
DOMAIN, youku-acs.m.taobao.com, REJECT-DROP

[Body Rewrite]
http-response-jq ^https:\/\/un-acs\.youku\.com\/gw\/mtop\.youku\.play\.ups\.appinfo\.get 'reduce [["data","data","ad"],["data","data","watermark"],["data","data","ykad"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/push\.m\.youku\.com\/collect-api\/get_push_interval_config_wx\? 'reduce [["data","tipContent"],["data","tipContentNew"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'

[MITM]
hostname = %APPEND% push.m.youku.com, un-acs.youku.com
