#!name=快递100去广告
#!desc=移除横幅广告、弹窗广告，精简首页。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id458270120
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KuaiDi100.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/KuaiDi100_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Map Local]
^https?:\/\/p\.kuaidi100\.com\/advertisement\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/p\.kuaidi100\.com\/e-commerce\/act\/actInfo\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/p\.kuaidi100\.com\/apicenter\/card\.dox data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https?:\/\/p\.kuaidi100\.com\/mobile\/mobileapi\.do$ 'reduce [["adsplash"],["adIsConsumable"],["adProductId"],["nologin_tips"],["index_banner"],["me_banner"],["index_banner_shadow"],["adshongbao"],["adsapp_homepage_ticket_pop"],["adsoptimizationsend"],["adsapp_activity_ad_array"],["adbanner"],["adposition"],["adShowAgainTime"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/p\.kuaidi100\.com\/apicenter\/xcx\.dox 'reduce [["data","secondMenuList"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'

[MITM]
hostname = %APPEND% p.kuaidi100.com
