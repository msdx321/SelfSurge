#!name=微脉圈去广告
#!desc=移除开屏广告、聊天页横幅提示及发现页面的横幅广告。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id1427096901
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!system=ios
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weimai.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/Weimai_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Body Rewrite]
http-response-jq ^https:\/\/confssl\d?\.iweimai\.cn\/wm_ios_update\.json\? 'reduce [[["isShowCJAd"],[],"isShowCJAd",0]][] as $item (.;. as $before | try (if (getpath($item[1]) | has($item[2])) then setpath($item[0];$item[3]) else . end) catch $before)'
http-response-jq ^https:\/\/confssl\d?\.iweimai\.cn\/wm_ios_update\.json\? 'reduce [["launchAd"],["adBanners"],["ad"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'

[MITM]
hostname = %APPEND% confssl*.iweimai.cn
