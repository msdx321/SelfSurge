#!name=游民星空
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!category=去广告
#!author=奶思
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://raw.githubusercontent.com/msdx321/SelfSurge/main/modules/Gamersky.sgmodule
#!tg-channel=https://t.me/inaisi
#!requirement=CORE_VERSION>=20

# Source: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Surge/module/split/partY/Gamersky.sgmodule
# Modified by SelfSurge: normalized metadata, jq syntax, and resource URLs.
# License: GPL-3.0; see resources/licenses/fmz200-wool_scripts-LICENSE.

[Rule]
DOMAIN-SUFFIX,ja.gamersky.com,REJECT
DOMAIN-SUFFIX,ja1.gamersky.com,REJECT

[Body Rewrite]
http-response-jq http:\/\/.+\.gamersky.com/.+/lists/getListElements '.listElements |= map(select(has("adCategory") | not))'

[Map Local]
# 移除开屏广告、列表广告
^http:\/\/.+\.gamersky\.com\/.+\/adSystem\/ad\/.+ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

https://.+\.gamersky.com/v1/statisticAd data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% *.gamersky.com
