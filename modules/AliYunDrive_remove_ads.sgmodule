[Rule]
IP-CIDR, 203.107.1.1/24, REJECT-DROP, no-resolve

[Map Local]
^https:\/\/member\.alipan\.com\/v2\/activity\/sign_in_luckyBottle data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.alipan\.com\/adrive\/v1\/file\/getTopFolders data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
移除阿里云盘广告 = type=http-response,pattern=^https:\/\/(biz)?api\.alipan\.com\/apps\/v\d\/users?\/home\/(news|widgets),script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/AliYunDrive/AliYunDrive_remove_ads.js,requires-body=true
移除阿里云盘广告 2 = type=http-response,pattern=^https:\/\/member\.alipan\.com\/v1\/users\/onboard_list,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/AliYunDrive/AliYunDrive_remove_ads.js,requires-body=true

[MITM]
hostname = %APPEND% api.alipan.com, member.alipan.com, bizapi.alipan.com
