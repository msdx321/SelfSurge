[URL Rewrite]
^https:\/\/j1\.pupuapi\.com\/client\/account\/discount\/order _ reject
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7\?position_types=100 _ reject

[Script]
移除朴朴超市广告 = type=http-response,pattern=^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/PuPuMall/PuPuMall_remove_ads.js,requires-body=true
移除朴朴超市广告 2 = type=http-response,pattern=^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/search_component_banner,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/PuPuMall/PuPuMall_remove_ads.js,requires-body=true
移除朴朴超市广告 3 = type=http-response,pattern=^https:\/\/j1\.pupuapi\.com\/client\/search\/hot_keywords\/v3,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/PuPuMall/PuPuMall_remove_ads.js,requires-body=true
移除朴朴超市广告 4 = type=http-response,pattern=^https:\/\/j1\.pupuapi\.com\/client\/app_resource\/resource_preload\/list_h5_resource,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/PuPuMall/PuPuMall_remove_ads.js,requires-body=true
移除朴朴超市广告 5 = type=http-response,pattern=^https:\/\/j1\.pupuapi\.com\/client\/recommendation\/interests\/products,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/PuPuMall/PuPuMall_remove_ads.js,requires-body=true
移除朴朴超市广告 6 = type=http-response,pattern=^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/v1,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/PuPuMall/PuPuMall_remove_ads.js,requires-body=true

