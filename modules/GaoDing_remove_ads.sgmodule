#!name=稿定设计去广告
#!desc=移除稿定设计开屏广告、首页轮播图和弹窗，移除功能入口角标。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id1113276760
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/GaoDing.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/GaoDing_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Map Local]
^https:\/\/www\.gaoding\.com\/api\/v\d\/oc\/v\d\/delivery-pits\/ios-splash\/modules$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/www\.gaoding\.com\/api\/v\d\/oc\/delivery-pits\/(template|mine|home)-page-dialog\/modules$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/www\.gaoding\.com\/api\/v\d\/cp\/search-words\/v2\/placeholder data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/www\.gaoding\.com\/api\/v\d\/oc\/exhibitions\/template\/resources$ '.pits |= map(select(.module_type != "BANNER"))'
http-response-jq ^https:\/\/www\.gaoding\.com\/api\/v\d\/oc\/exhibitions\/app_mine\/resources$ '.pits |= map(select(.module_type != "BANNER"))'
http-response-jq ^https:\/\/www\.gaoding\.com\/api\/v\d\/oc\/exhibitions\/(templates|all_editor_tools)\/resources$ 'walk( if type == "object" and .badge_img_url? then .badge_img_url="" else . end )'

[MITM]
hostname = %APPEND% www.gaoding.com
