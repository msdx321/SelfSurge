#!name=胖乖生活去广告
#!desc=移除开屏广告、横幅轮播图、网格广告、信息流广告、浮窗广告，精简我的页面。
#!openUrl=https://apps.apple.com/app/id1597902801
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PangguaiLife.png
#!date=2026-06-01 17:11:35

[Map Local]
^https:\/\/userapi\.qiekj\.com\/slot\/get$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/userapi\.qiekj\.com\/appTitle\/get$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/userapi\.qiekj\.com\/integralRecord\/integralDailStatistics$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/userapi\.qiekj\.com\/local-life\/category$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/userapi\.qiekj\.com\/integralGoods\/queryIntegralGoodsPage$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/userapi\.qiekj\.com\/task\/list$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/userapi\.qiekj\.com\/local-life\/tab-order$ 'if (getpath([]) | has("data")) then setpath(["data"];[]) else . end'
http-response-jq ^https:\/\/userapi\.qiekj\.com\/integralGoods\/queryIntegralGoodsCategoryList$ 'if (getpath([]) | has("data")) then setpath(["data"];[]) else . end'

[MITM]
hostname = %APPEND% userapi.qiekj.com
