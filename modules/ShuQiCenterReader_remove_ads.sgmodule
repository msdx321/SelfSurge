[Rule]
DOMAIN, render-web.11222.cn, REJECT-DROP

[URL Rewrite]
^https:\/\/ocean\.shuqireader\.com\/api\/render\/load\/resource _ reject

[Map Local]
^https:\/\/huichuan\.sm\.cn\/nativead data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/ocean\.shuqireader\.com\/api\/route\/iosReadPage\/adV2 data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/ocean\.shuqireader\.com\/api\/route\/ios\/readPage$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
移除书城横幅和阅读广告 = type=http-response,pattern=^https:\/\/ocean\.shuqireader\.com\/sqios\/render\/render\/page\/bookstore$,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/ShuQiCenterReader/ShuQiCenterReader_remove_ads.js,requires-body=true

[MITM]
hostname = %APPEND% ocean.shuqireader.com, huichuan.sm.cn
