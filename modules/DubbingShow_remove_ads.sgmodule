#!name=配音秀去广告
#!desc=移除开屏广告、弹窗、横幅、各类关注推荐。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id746925035
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DubbingShow.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/DubbingShow_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Body Rewrite]
http-response-jq ^https:\/\/iosapi\.peiyinxiu\.com\/Api\/live\/LiveList 'reduce [["data","banners"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/iosapi\.peiyinxiu\.com\/api\/live\/FollowList 'reduce [["obj","data"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/iosapi\.peiyinxiu\.com\/Api\/Friend\/GetRecommendUsers 'reduce [["obj","data"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/iosapi\.peiyinxiu\.com\/api\/Union\/HomeData 'reduce [["obj","data"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'

[Script]
移除首页底部弹窗 = type=http-response,pattern=^https:\/\/iosapi\.peiyinxiu\.com\/Api\/Film\/GetConfigValue,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/DubbingShow/DubbingShow_remove_ads.js,requires-body=true

[MITM]
hostname = %APPEND% iosapi.peiyinxiu.com
