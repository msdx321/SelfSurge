#!name=测测去广告
#!desc=移除开屏广告、活动皮肤、各类弹窗及横幅、金刚位红点文字，精简首页标签及搜索页面。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id756771906
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Cece.png
#!date=2026-05-13 00:20:48
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/Cece_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Map Local]
^https:\/\/api\.cece\.com\/user\/index\/banners\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.cece\.com\/ask\/ai_chat\/popup\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.cece\.com\/user\/popup\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.cece\.com\/chart\/easter_egg\/popup\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.cece\.com\/user\/register_task\/notice_task\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.cece\.com\/ask\/ask\/alert_minus\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.cece\.com\/msgAsk\/question\/new_coupon_status\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.cece\.com\/user\/user\/myPageBanner\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.cece\.com\/live\/user\/coupon_tab\? data-type=base64 data="eyJjb2RlIjowLCJtc2ciOiIifQ==" header="Content-Type:application/json" status-code=200
^https:\/\/api\.cece\.com\/live\/recommend\/new_user\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.cece\.com\/chart\/tools\/get_search_recommend\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.cece\.com\/user\/rank\/list\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.cece\.com\/chart\/config\/chart_activity\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/api\.cece\.com\/user\/init\? 'reduce [["data","launch_img_url"],["data","launch_goto_url"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/api\.cece\.com\/common\/app\/app_config\? 'reduce [[["data","is_new_year"],["data"],"is_new_year",false],[["data","spring_festival"],["data"],"spring_festival",false],[["data","show_feedback_entry"],["data"],"show_feedback_entry",false],[["data","show_course_entry"],["data"],"show_course_entry",false],[["data","show_store_entry"],["data"],"show_store_entry",false],[["data","show_luna"],["data"],"show_luna",false],[["data","show_ead"],["data"],"show_ead",false],[["data","show_ad"],["data"],"show_ad",false],[["data","show_live_filter_tarot"],["data"],"show_live_filter_tarot",false],[["data","community_feed_adswitch"],["data"],"community_feed_adswitch",false],[["data","open_screen_ad_times"],["data"],"open_screen_ad_times",0],[["data","open_screen_ad_duration"],["data"],"open_screen_ad_duration",0],[["data","isShowThumbsGif"],["data"],"isShowThumbsGif",false],[["data","teenager_mode_open"],["data"],"teenager_mode_open",false],[["data","flu_log"],["data"],"flu_log",false]][] as $item (.;. as $before | try (if (getpath($item[1]) | has($item[2])) then setpath($item[0];$item[3]) else . end) catch $before)'
http-response-jq ^https:\/\/api\.cece\.com\/common\/app\/app_config\? 'reduce [["data","activity_list"],["data","fortune_ab_config"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/api\.cece\.com\/chart\/tools\/home_10_tools\? '.data.tools |= map(del(.icon_tip_image))'
http-response-jq ^https:\/\/api\.cece\.com\/user\/index\/tab_list\? '.data.tabs |= map(select(.type != "shop"))'
http-response-jq ^https:\/\/api\.cece\.com\/common\/app\/risk_entrance\? 'reduce [[["data","ai_fortune_show_ask_tool"],["data"],"ai_fortune_show_ask_tool",false],[["data","ai_sign_show_ask_tool"],["data"],"ai_sign_show_ask_tool",false],[["data","single_tool_show_dice_card"],["data"],"single_tool_show_dice_card",false],[["data","single_tool_show_tarot_card"],["data"],"single_tool_show_tarot_card",false],[["data","single_tool_show_bazi_card"],["data"],"single_tool_show_bazi_card",false],[["data","single_tool_show_hepan_card"],["data"],"single_tool_show_hepan_card",false],[["data","single_tool_show_ziwei_card"],["data"],"single_tool_show_ziwei_card",false],[["data","single_tool_show_xingpan_card"],["data"],"single_tool_show_xingpan_card",false],[["data","multi_tool_show_card"],["data"],"multi_tool_show_card",false],[["data","ai_ccai_show_multi_tool"],["data"],"ai_ccai_show_multi_tool",false]][] as $item (.;. as $before | try (if (getpath($item[1]) | has($item[2])) then setpath($item[0];$item[3]) else . end) catch $before)'

[MITM]
hostname = %APPEND% api.cece.com
