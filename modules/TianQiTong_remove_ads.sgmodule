#!name=天气通去广告
#!desc=移除开屏广告、横幅广告、弹窗广告，精简底栏及我的页面。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id458032309
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TianQiTong.png
#!date=2026-07-02 20:09:47
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/TianQiTong_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Map Local]
^https:\/\/forecast\.sina\.cn\/app\/overall\/switch\.php\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/tqt\.weibo\.cn\/business\/advert\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/tqt\.weibo\.cn\/user\/device\/ad_multi_star\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/tqt\.weibo\.cn\/operation\/activity\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/tqt\.weibo\.cn\/api\/user\/user\/\d\.\d\/\?method=personal_center$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/tqt\.weibo\.cn\/master\/nav\/tab\? 'map(.tabs|=map(select(.type=="weather" or .type=="radar" or .type=="my")))'

[MITM]
hostname = %APPEND% forecast.sina.cn, tqt.weibo.cn
