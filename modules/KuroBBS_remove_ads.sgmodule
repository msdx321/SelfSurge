[Map Local]
^https:\/\/api\.kurobbs\.com\/config\/getOpenScreen$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.kurobbs\.com\/config\/index\/windows$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.kurobbs\.com\/config\/search\/getSearchConfig\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.kurobbs\.com\/forum\/app\/topic\/hotlist\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api.kurobbs.com
