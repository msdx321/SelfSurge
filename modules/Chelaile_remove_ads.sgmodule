#!name=车来了去广告
#!desc=清洗配置，移除开屏广告、首页金刚位、文章推荐，精简我的页面。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id667831823
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chelaile.png
#!date=2026-07-04 19:58:28
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/Chelaile_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN, ad.chelaile.net.cn, REJECT

[URL Rewrite]
^https:\/\/cdn\.web\.chelaile\.net\.cn\/info-flow\/index\.html\? _ reject

[Map Local]
^https:\/\/api\.chelaile\.net\.cn\/goocity\/flowPos\/home\? data-type=base64 data="" header="Content-Type:application/json" status-code=200
^https:\/\/api\.chelaile\.net\.cn\/goocity\/flowPos\/listByPos\? data-type=base64 data="KipZR0tKe31ZR0tKIyM=" header="Content-Type:application/json" status-code=200
^https:\/\/web\.chelaile\.net\.cn\/api\/operative_position\/infoflow\/getInfo\? data-type=base64 data="KipZR0tKe31ZR0tKIyM=" header="Content-Type:application/json" status-code=200
^https:\/\/image3\.chelaile\.net\.cn\/hw6u6LYY\.png$ data-type=tiny-gif status-code=200
^https:\/\/api\.chelaile\.net\.cn\/led-weather\/v\d\/condition_brief\? data-type=base64 data="KipZR0tKe31ZR0tKIyM=" header="Content-Type:application/json" status-code=200
^https:\/\/api\.chelaile\.net\.cn\/goocity\/config\/notices\? data-type=base64 data="KipZR0tKe31ZR0tKIyM=" header="Content-Type:application/json" status-code=200
^https:\/\/api\.chelaile\.net\.cn\/encourage\/activity\/control\? data-type=base64 data="KipZR0tKe31ZR0tKIyM=" header="Content-Type:application/json" status-code=200

[Script]
清洗配置 = type=http-response,pattern=^https:\/\/api\.chelaile\.net\.cn\/bus-side\/appToggle\/getStatus\?,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/Chelaile/Chelaile_remove_ads.js,requires-body=true

[MITM]
hostname = %APPEND% api.chelaile.net.cn, web.chelaile.net.cn, cdn.web.chelaile.net.cn, image3.chelaile.net.cn
