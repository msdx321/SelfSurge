[Map Local]
^https?:\/\/mime\.baidu\.com\/v5\/start_screen_ads/list data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/mime\.baidu\.com\/sapi\/v1\/lccorpus\/(applist|pannellist) data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/mime\.baidu\.com\/sapi\/v1\/(circle\/joinedlist|lccorpus\/usercorpussync|aihelpactivity\/aihelpresource) data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/mime\.baidu\.com\/commer\/pocket_api\/enterprise_list data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/mbd\.baidu\.com\/ccs\/v1\/start\/confsync\?appname=baidu_input data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/mime\.baidu\.com\/v5\/(fb\/st\?logtype|(notiv3|cellloc_noti|noti_cloudswitch_noti)\/info) data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
百度输入法去广告 = type=http-response,pattern=^https?:\/\/mime\.baidu\.com\/(imrobot\/v1\/pub\/relation\/get_robot_list|v5\/custom_page\/(layout|getdata)),script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/Baidu_input_method/Baidu_input_method_remove_ads.js,requires-body=true

[MITM]
hostname = %APPEND% imeres.baidu.com, mbd.baidu.com, mime.baidu.com
