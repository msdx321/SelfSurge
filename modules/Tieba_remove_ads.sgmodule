#!name=百度贴吧去广告
#!desc=移除开屏广告、信息流广告和帖内广告，精简侧拉抽屉及我的页面。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id477927812
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], app2smile[https://github.com/app2smile]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Tieba.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20
#!arguments=per_filter_video_thread:true
#!arguments-desc=Loon 选项与策略已转为 Surge 自由输入；脚本参数按同名字段传入，具体格式见模块注释；enable 字段为 false 时脚本需立即退出。

# Source: https://kelee.one/Tool/Loon/Lpx/Tieba_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

# Surge 参数 per_filter_video_thread：默认 true；可选 true | false；拦截推荐页面视频帖；此项决定是否拦截首页推荐标签下的视频帖

[Rule]
DOMAIN, 180.76.76.200, REJECT
IP-CIDR, 180.76.76.200/32, REJECT, no-resolve

[Map Local]
^https?:\/\/tiebac\.baidu\.com\/c\/f\/forum\/getInterestClassList$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/tiebac\.baidu\.com\/c\/f\/search\/discover$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/tieba\.baidu\.com\/mo\/q\/search\/startPage\? data-type=base64 data="eyJubyI6MCwiZXJyb3IiOiJzdWNjZXNzIn0=" header="Content-Type:application/json" status-code=200
^https?:\/\/tieba\.baidu\.com\/c\/f\/search\/discover$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/tieba\.baidu\.com\/c\/f\/forum\/getForumAlbum$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^http:\/\/c\.tieba\.baidu\.com\/c\/f\/forum\/hotforum$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/s\/sync$ 'reduce [["activity_switch"],["video_report_config"],["advertisement_config"],["next_start"],["push_strategy_new"],["live_activity_guide"],["h5_pop_ups"],["duxiaoman_url"],["is_need_remind_live_rooms"],["floating_icon"],["ad_stlog_switch"],["first_time_motivate"],["windowStrategyList"],["ad_adsense"],["ad_config"],["videoup_guide_pop"],["ad_origin_config_switch"],["needNewUserLead"],["h5_pop_ups_config"],["alaTabColor"],["search_guide"],["ad_sdk_priority"],["low_version_pop_config"],["ad_num_competition_frs"],["live_new_user_guide_day"],["screen_fill_data_result"],["yy_live_tab"],["ad_num_competition_personalize"],["complete_apk_url"],["user_activity"],["homepage_guide"],["bottom_bubble_config"],["home_screen_ad"],["afSearch_tab"],["recent_client_info"],["video_activity"],["namoaixud_url"],["yy_live_config"],["user_growth_task_list"],["cloud_control_data_info"],["wl_config","pb_banner_funad_cache_strategy"],["wl_config","pb_comment_asyncafd_cache_strategy"],["wl_config","download_edge_float"],["wl_config","download_pause_retain_dialog_conf"],["wl_config","download_mobile_dialog_conf"],["wl_config","download_fake_progress_config_a"],["wl_config","download_fake_progress_config_b"],["scheme_whitelist"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/s\/sync$ 'reduce [[["wl_config","home_ad_num"],["wl_config"],"home_ad_num",0],[["wl_config","frs_ad_num"],["wl_config"],"frs_ad_num",0],[["wl_config","pb_comment_ad_num"],["wl_config"],"pb_comment_ad_num",0],[["wl_config","index_bear_density"],["wl_config"],"index_bear_density",0],[["wl_config","frs_bear_density"],["wl_config"],"frs_bear_density",0],[["wl_config","index_bear_first_floor_max"],["wl_config"],"index_bear_first_floor_max",999999999],[["wl_config","index_bear_first_floor_min"],["wl_config"],"index_bear_first_floor_min",999999999]][] as $item (.;. as $before | try (if (getpath($item[1]) | has($item[2])) then setpath($item[0];$item[3]) else . end) catch $before)'
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/s\/sync$ '.index_tab_info |= map(select(.tab_name == "推荐")) | .top_level_navi |= {"推荐": .["推荐"], "侧边栏": .["侧边栏"], "关注": .["关注"]}'
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/u\/user\/profile$ 'reduce [["url_map"],["user_agent_info"],["bubble_info"],["duxiaoman_entry"],["uc_card"],["finance_tab"],["vip_banner"],["ala_live_info"],["recom_naws_list"],["duxiaoman"],["user","consume_info"],["namoaixud_entry"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/u\/user\/profile$ 'reduce [[["user","shake_ad_switch","is_show"],["user","shake_ad_switch"],"is_show",0]][] as $item (.;. as $before | try (if (getpath($item[1]) | has($item[2])) then setpath($item[0];$item[3]) else . end) catch $before)'
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/u\/user\/profile$ '.custom_grid |= map(select(.title != "游戏大厅" and .title != "预约管理" and .title != "领话费" and .title != "短故事")) | .zone_info |= map(.common_func |= ( if .common_func_noraml then .common_func_noraml |= map(select(.name != "创建智能体")) else . end )) | .zone_info |= map(select(.type != "commerce" and .type != "banner" and .type != "game"))'
http-response-jq ^https?:\/\/tieba\.baidu\.com\/c\/f\/forum\/forumGuide$ 'reduce [["hot_search"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/tieba\.baidu\.com\/c\/f\/frs\/frsBottom\? 'reduce [["card_activity"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/f\/frs\/frsBottom$ 'reduce [["card_activity"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/tiebac\.baidu\.com\/c\/f\/sidebar\/home$ 'reduce [["game_center"],["tools"],["task_list"],["vip_banner"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'

[Script]
ProtoBuf处理 = type=http-response,pattern=^https?:\/\/tieba(?:c)?\.baidu\.com\/c\/(f\/excellent\/personalized|f\/frs\/page|b\/ad\/adBid|f\/ad\/getFeedAd|f\/pb\/page|f\/frs\/generalTabList)\?cmd=\d+&format=protobuf,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/Tieba/tieba-proto.js,requires-body=true,binary-body-mode=true,timeout=10,argument="per_filter_video_thread={{{per_filter_video_thread}}}"

[MITM]
hostname = %APPEND% tiebac.baidu.com, tieba.baidu.com
