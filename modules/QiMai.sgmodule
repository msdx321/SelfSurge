[URL Rewrite]
^https?:\/\/(?>webapi|miniapp)\.qmai\.cn\/web\/cmk-center\/marketing\/canvas\/advert - reject

[Script]
QiMai-13 = type=http-response, pattern=^https?:\/\/(?>webapi|miniapp)\.qmai\.cn\/web\/catering([0-9]-apiserver)?\/advertising\/ad\/advertiseInfo, script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/upstream/6c23ec663dccbcbc.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% webapi.qmai.cn, miniapp.qmai.cn
