[URL Rewrite]
^https:\/\/api1\.zongheng\.com\/iosapi\/system\/startup$ _ reject

[Map Local]
^https:\/\/api2\.zongheng\.com\/api\/giftBag\/bindingBag$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api?.zongheng.com
