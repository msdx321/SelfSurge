^https:\/\/mall\.meituan\.com\/api\/c\/homepage\/bubble\/operate\/info data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/mall\.meituan\.com\/api\/c\/jigsaw\/code\/category-banner-\d+\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/mall\.meituan\.com\/api\/c\/poi\/\d+\/order\/recommend\/v\d data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/mall\.meituan\.com\/api\/c\/banner\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/mall\.meituan\.com\/api\/c\/poi\/\d+\/personal\/recommend data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/businessapi\.ksedt\.com\/signupindex\/jxlist data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
移除下发广告 = type=http-response,pattern=^https:\/\/portal-portm\.meituan\.com\/horn_ios\/mergeRequest,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/iMaiCai/iMaiCai_remove_ads.js,requires-body=true

[MITM]
hostname = %APPEND% portal-portm.meituan.com, mall.meituan.com, businessapi.ksedt.com
