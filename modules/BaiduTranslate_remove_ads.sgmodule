#!name=百度翻译去广告
#!desc=移除开屏广告、横幅广告，精简我的页面。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id605670941
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BaiduTranslate.png
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/BaiduTranslate_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Map Local]
(?i)^https:\/\/fanyi-app\.baidu\.com\/transapp\/v2\/api\/launch\/config\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/fanyi-app\.baidu\.com\/static\/react-activity\/page\/courseBoutique\.html\? data-type=text data="" status-code=404

[Body Rewrite]
http-response-jq (?i)^https:\/\/fanyi-app\.baidu\.com\/transapp\/comment\/my\? 'reduce [["data","taskBanner"],["data","act"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq (?i)^https:\/\/fanyi-app\.baidu\.com\/transapp\/recitewd\/myplan\? 'reduce [["data","activityRec"],["data","activityRecList"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'

[MITM]
hostname = %APPEND% fanyi-app.baidu.com
