#!date=2026-06-01 17:11:35

[Map Local]
^https:\/\/energy\.xiaojukeji\.com\/energy\/hummer\/api\/resource\/display($|\?) data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/energy\.xiaojukeji\.com\/lego\/api\/orderSprint\/stair\/info($|\?) data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/energy\.xiaojukeji\.com\/station-api\/search\/preWords$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/am\.didistatic\.com\/static\/am\/cf-terminal\/epower\/epower-thanos-app\/\d+\.\d+\.\d+\/pages\/people\/index\.js$ data-type=file data="https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/XiaojukejiCharge/XiaojukejiCharge_remove_ads.js" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/energy\.xiaojukeji\.com\/am\/marketing\/api\/member\/facade\/charge\/personal\/center\? 'delpaths([["data"]])'

[MITM]
hostname = %APPEND% energy.xiaojukeji.com, am.didistatic.com
