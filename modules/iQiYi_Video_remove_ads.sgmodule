#!name=爱奇艺去广告
#!desc=移除开屏广告、焦点图广告、瀑布流广告、搜索页面广告、移除青少年弹窗，精简底栏和我的页面。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id1190755526
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/iQiYi_Video.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/iQiYi_Video_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
IP-CIDR, 103.44.59.54/32, REJECT-DROP, no-resolve
IP-CIDR, 111.63.147.158/32, REJECT-DROP, no-resolve
IP-CIDR, 116.211.198.237/32, REJECT-DROP, no-resolve
DOMAIN-SUFFIX, cupid.iqiyi.com, DIRECT
DOMAIN, api.iqiyi.com, REJECT-DROP
DOMAIN, access.if.iqiyi.com, REJECT-DROP

[Map Local]
^https?:\/\/iface2\.iqiyi\.com\/control\/3\.0\/init_proxy\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/act\.vip\.iqiyi\.com\/interact\/api\/v2\/show\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/iface2\.iqiyi\.com\/ivos\/interact\/video\/data\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/iface2\.iqiyi\.com\/video\/3\.0\/v_interface_proxy\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/iface2\.iqiyi\.com\/views_pop\/3\.0\/pop_control\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/cards\.iqiyi\.com\/views_home\/3\.0\/qy_home\? 'reduce [["base","statistics"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/cards\.iqiyi\.com\/views_home\/3\.0\/qy_home\? 'del(.cards[] | select(.alias_name == "focus" or .alias_name == "ad_mobile_flow" or .alias_name == "ad_trueview"))'
http-response-jq ^https:\/\/cards\.iqiyi\.com\/views_category\/3\.0\/category_home\? 'del(.base.statistics | select(.ad_str)) | del(.cards[] | select(.alias_name == "entrence_focus" or .alias_name == "ad_trueview"))'
http-response-jq ^https:\/\/cards\.iqiyi\.com\/waterfall(-plt)?\/3\.0\/feed\? 'del(.base.statistics | select(.ad_str)) | del(.. | select(.block_class?))'
http-response-jq ^https:\/\/cards\.iqiyi\.com\/views_plt\/3\.0\/player_tabs_v2\? 'reduce [["kv_pair","activity_tab"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/cards\.iqiyi\.com\/views_plt\/3\.0\/player_tabs_v2\? 'del(.cards[] | select(.alias_name == "play_vip_promotion" or .alias_name == "play_detail_tag" or .alias_name == "play_chat_entrance" or .alias_name == "play_ad_no_vip" or .alias_name == "play_vertical_short_video" or .alias_name == "play_rap_custom" or .alias_name == "play_topical_tab" or .alias_name == "play_vertical" or .alias_name == "play_water_fall_like")) | del(.. | select(.block_class?))'
http-response-jq ^https:\/\/comment-card\.iqiyi\.com\/views_comment\/3\.0\/long_video_comments\? '.'
http-response-jq ^https:\/\/cards\.iqiyi\.com\/views_search\/3\.0\/hot_query_search\? '.cards |= map(select(.alias_name as $name | $name != "ad_trueview" and $name != "ad_mobile_flow" and $name != "search_mid_text_ad")) | if .base.statistics.ad_str? then del(.base.statistics) else . end'
http-response-jq ^https?:\/\/comment-card\.iqiyi\.com\/views_comment\/3\.0\/long_video_comments\? '.cards |= map(select(has("alias_name")))'
http-response-jq ^https?:\/\/iface2\.iqiyi\.com\/views_menus\/3\.0\/bottom_theme\? 'reduce [["theme_list"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/iface2\.iqiyi\.com\/views_menus\/3\.0\/bottom_theme\? '.cards |= map(.items |= map(select(.other.bottom_tab_type == "rec" or .other.bottom_tab_type == "my")))'
http-response-jq ^https?:\/\/iface2\.iqiyi\.com\/views_menus\/3\.0\/home_top_menu\? '.nav_group_data[].nav_list |= map(select(. == "0" or . == "2" or . == "1007" or . == "1" or . == "6" or . == "3"))'
http-response-jq ^https?:\/\/iface2\.iqiyi\.com\/fusion\/3\.0\/common_switch\? 'reduce [["content","resource","cast_device_ad"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/iface2\.iqiyi\.com\/fusion\/3\.0\/common_switch\? 'reduce [[["content","switchs","app_ad","app_ad_enable"],["content","switchs","app_ad"],"app_ad_enable",0],[["content","switchs","app_ad","app_ad_duration"],["content","switchs","app_ad"],"app_ad_duration",0],[["content","switchs","ios_tech","kPreadAdHintSwitch"],["content","switchs","ios_tech"],"kPreadAdHintSwitch",0],[["content","switchs","ios_tech","ad_download"],["content","switchs","ios_tech"],"ad_download",0],[["content","switchs","m_qiyi_ios_tech","KFocusAdVideoPlayTimesIn4G"],["content","switchs","m_qiyi_ios_tech"],"KFocusAdVideoPlayTimesIn4G",0]][] as $item (.;. as $before | try (if (getpath($item[1]) | has($item[2])) then setpath($item[0];$item[3]) else . end) catch $before)'
http-response-jq ^https?:\/\/(kjp|t7z)\.cupid\.iqiyi\.com\/mixer\? 'reduce [["adSlots"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/search\.video\.iqiyi\.com\/q\? 'reduce [["data"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/iface2\.iqiyi\.com\/aggregate\/3\.0\/getMyMenus\? '.data |= map(select(.statistic.block != "wd_liebiao_2") | select(all(.menuList[]?.statistic2.block; . != "wd_liebiao_3")))'

[MITM]
hostname = %APPEND% -i.vip.iqiyi.com, *.iqiyi.com
