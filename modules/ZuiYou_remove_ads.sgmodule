#!name=最右去广告
#!desc=移除开屏广告、信息流广告和广告轮播图。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id942443472
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ZuiYou.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/ZuiYou_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN, adapi.izuiyou.com, REJECT-DROP
# Converted to rewrite: URL-REGEX, "^http:\/\/mercury-gateway\.ixiaochuan\.cn\/mercury\/v1\/ad\/", REJECT-DICT
URL-REGEX, "^http:\/\/file-share\.izuiyou\.com\/octopus\/media\/templates\/search_home_page_(nv|nv_v2)\/search_home_page_nv", REJECT-DROP

[URL Rewrite]
^https?:\/\/api\.izuiyou\.com\/ad\/ _ reject

[Map Local]
"^http:\/\/mercury-gateway\.ixiaochuan\.cn\/mercury\/v1\/ad\/" data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/api\.izuiyou\.com\/config\/get_banner data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/zyfile\.izuiyou\.com\/zyfile\/c2\/a0\/[a-z0-9-]+\.json data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api.izuiyou.com, zyfile.izuiyou.com
