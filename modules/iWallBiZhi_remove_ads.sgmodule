[Map Local]
(?i)^https:\/\/api\.fzxhmy\.com\/seek\/trendingword\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.fzxhmy\.com\/tone\/trending\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
移除首页广告配置 = type=http-response,pattern=(?i)^https:\/\/api\.fzxhmy\.com\/core\/initialize\?,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/iWallBiZhi/core_initialize.js,requires-body=true
移除首页轮播图广告 = type=http-response,pattern=(?i)^https:\/\/api\.fzxhmy\.com\/landing\/initialize\?,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/iWallBiZhi/landing_initialize.js,requires-body=true
移除头像页横幅跳转 = type=http-response,pattern=(?i)^https:\/\/api\.fzxhmy\.com\/avatar\/landing\?,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/iWallBiZhi/landing.js,requires-body=true

[MITM]
hostname = %APPEND% api.fzxhmy.com
