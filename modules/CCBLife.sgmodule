[Rule]
# 内置饿了么外卖弹窗, REJECT
DOMAIN,o2o-ad-log-gateway.alibaba.com,REJECT

[URL Rewrite]
^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.alsc\.wamai\.store\.detail\.miniapp\.popup - reject
^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.venus\.shopcouponpopupservice\.getshopcouponspopup - reject

[Body Rewrite]
http-response ^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\? "TAG_AD_INFO" "fmz200"
http-response ^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.venus\.shopresourceservice\.getshopresource 'posterList' 'fmz200'

[Map Local]
# 首页横幅广告
^https?:\/\/yunbusiness\.ccb\.com\/clp_service\/txCtrl\?txcode=A3341A(002|006|009|119|120) data-type=text data=" " status-code=200

^https?:\/\/yunbusiness\.ccb\.com\/clp_service\/txCtrl\?txcode=A3341C147 data-type=text data=" " status-code=200

# 内置饿了么
^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.alsc\.eleme\.\w+\.trigger\.respond data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\?txcode=A3341AB05 data-type=file data="https://raw.githubusercontent.com/msdx321/SelfSurge/main/resources/upstream/211dd89152aa20f5.json" status-code=200 header="Content-Type:application/json"

[Script]
CCBLife-38 = type=http-response, pattern=^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\?txcode=A3341AB04, script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/upstream/3395dfee80c43cfe.js, requires-body=true, timeout=60

# 内置饿了么
CCBLife-41 = type=http-response, pattern=^https?:\/\/g\.alicdn\.com\/.*o2o-ad, script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/upstream/a1536927e11e0b56.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% yunbusiness.ccb.com, g.alicdn.com, waimai-guide.ele.me
