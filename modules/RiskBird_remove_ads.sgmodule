[Map Local]
^https:\/\/m\.riskbird\.com\/prod-qbb-api\/user\/getBannerList data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/m\.riskbird\.com\/prod-qbb-api\/searchHotEnt data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
移除推荐老板 = type=http-response,pattern=^https:\/\/m\.riskbird\.com\/prod-qbb-api\/query\/person\/personRecommend,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/RiskBird/RiskBird_remove_ads.js,requires-body=true

[MITM]
hostname = %APPEND% m.riskbird.com
