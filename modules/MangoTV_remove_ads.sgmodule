#!name=芒果TV去广告
#!desc=移除开屏广告、信息流广告、播放页广告，精简我的页面。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id629774477
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], RuCu6[https://github.com/RuCu6]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Mango_TV.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/MangoTV_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN, credits.bz.mgtv.com, REJECT-DROP
DOMAIN, credits2.bz.mgtv.com, REJECT-DROP
DOMAIN, credits3.bz.mgtv.com, REJECT-DROP
DOMAIN, dflow.bz.mgtv.com, REJECT-DROP
DOMAIN, encounter.bz.mgtv.com, REJECT-DROP
DOMAIN, floor.bz.mgtv.com, REJECT-DROP
DOMAIN, layer.bz.mgtv.com, REJECT-DROP
DOMAIN, mob.bz.mgtv.com, REJECT-DROP
DOMAIN, rc-topic-api.bz.mgtv.com, REJECT-DROP
DOMAIN, rprain.bz.mgtv.com, REJECT-DROP
DOMAIN, rprain.log.mgtv.com, REJECT-DROP
DOMAIN, vip.bz.mgtv.com, REJECT-DROP
DOMAIN-SUFFIX, da.mgtv.com, REJECT-DROP

[Map Local]
^https:\/\/dc\.bz\.mgtv\.com\/dynamic\/v\d\/skin\/config\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/dc\.bz\.mgtv\.com\/dynamic\/v\d\/channel\/ads\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^http:\/\/mobileso\.bz\.mgtv\.com\/spotlight\/search\/v\d\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/damang\.api\.mgtv\.com\/station\/album\/red\/dot\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/hb-boom\.api\.mgtv\.com\/release\/pullReleaseInfo$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/mobile\.api\.mgtv\.com\/v\d\/mobile\/checkUpdate\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/mobileso\.bz\.mgtv\.com\/mobile\/recommend\/v\d\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https?:\/\/mobile\.api\.(mgtv|hunantv)\.com\/mobile\/config\? 'reduce [[["data","dc_adConfig"],["data"],"dc_adConfig",0],[["data","XmsellSwitch"],["data"],"XmsellSwitch",0],[["data","screenshot_share_switch"],["data"],"screenshot_share_switch",0],[["data","playerUseHttpDNS"],["data"],"playerUseHttpDNS",0],[["data","damang_tab"],["data"],"damang_tab",0],[["data","relative_ads"],["data"],"relative_ads",0],[["data","second_floor_guide_switch"],["data"],"second_floor_guide_switch",0],[["data","progress_bar_ad_switch"],["data"],"progress_bar_ad_switch",0],[["data","XmVideoB"],["data"],"XmVideoB",0],[["data","damang_duanju_tab"],["data"],"damang_duanju_tab",0],[["data","playview_box_ad_switch"],["data"],"playview_box_ad_switch",0],[["data","topBarSwitch"],["data"],"topBarSwitch",0],[["data","VIPSDKB2"],["data"],"VIPSDKB2",0]][] as $item (.;. as $before | try (if (getpath($item[1]) | has($item[2])) then setpath($item[0];$item[3]) else . end) catch $before)'
http-response-jq ^https:\/\/me\.bz\.mgtv\.com\/v3\/module\/list\? '.data.list |= map(select(.id | IN(1, 2, 4, 7))) | .data.list |= map( if .moduleType == 2 then .data |= map(select(.moduleType == 11)) elif .moduleType == 4 then .data |= map(select(.moduleType == 14 or .moduleType == 23)) elif .moduleType == 7 then .data |= map(select(.moduleType == 16 and .title != "音乐广场")) else . end )'
http-response-jq ^https:\/\/me\.bz\.mgtv\.com\/v4\/module\/list\? '.data.list |= (map(select(.id != 3 and .id != 7))|map( if .id==2 then .data|=map(select(.id!=65))elif .id==4 then .data|=map(select(.title!="追更banner" and .id!=57))elif .id==5 then .data|=(map(select(.id==9 or .id==13))|map( if .id==9 then .list|=map(select(.id==20 or .id==60 or .id==18)) else . end ))elif .id==6 then .data|=map(select(.id==15)) else . end ))'
http-response-jq ^https?:\/\/dc\d?\.bz\.mgtv\.com\/dynamic\/v\d\/channel\/index\/\w 'reduce [["adInfo"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/dc\d?\.bz\.mgtv\.com\/dynamic\/v\d\/channel\/index\/\w '.data |= map(select(.moduleEntityId != "10579" and .moduleEntityId != "9686")) | .moduleIDS |= map(select(.moduleEntityId != "10579" and .moduleEntityId != "9686"))'
http-response-jq ^https:\/\/mobile-thor\.api\.mgtv\.com\/v\d+\/vod\/info\? 'reduce [["data","config","ad"],["data","config","vipNav"],["data","template","skinList"],["data","template","theme"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/mobile-thor\.api\.mgtv\.com\/v\d+\/vod\/info\? '.data.tabs |= map(select(.name == "视频" or .name == "讨论")) | .data.template.modules |= map( if .clipInfo.ext?.ipPublishEntrance then .clipInfo |= del(.ext) else . end ) | .data.template.modules |= map(select(.dataType == 101 or .dataType == 201)) | .data.template.modules |= map(.media.list |= ( if type == "array" then map(select(.type != 0)) else . end ))'
http-response-jq ^https:\/\/comment\.mgtv\.com\/v\d\/comment\/getCommentList\? '.data.list |= map(select(.type == 0))'

[MITM]
hostname = %APPEND% dc?.bz.mgtv.com, mobileso.bz.mgtv.com, damang.api.mgtv.com, hb-boom.api.mgtv.com, mobile.api.mgtv.com, mobile.api.hunantv.com, me.bz.mgtv.com, mobile-thor.api.mgtv.com
