[Rule]
DOMAIN, adsmind.gdtimg.com, REJECT-DROP
DOMAIN, adsmind.ugdtimg.com, REJECT-DROP
DOMAIN, c2.gdt.qq.com, REJECT-DROP
DOMAIN, huatuocode.huatuo.qq.com, REJECT-DROP
DOMAIN, info4.video.qq.com, REJECT-DROP
DOMAIN, info6.video.qq.com, REJECT-DROP
DOMAIN, ios.bugly.qq.com, REJECT-DROP
DOMAIN, ios.video.mpush.qq.com, REJECT-DROP
DOMAIN, mi.gdt.qq.com, REJECT-DROP
DOMAIN, otheve.beacon.qq.com, REJECT-DROP
DOMAIN, pgdt.gtimg.cn, REJECT-DROP
DOMAIN, pgdt.ugdtimg.com, REJECT-DROP
DOMAIN, qzs.gdtimg.com, REJECT-DROP
DOMAIN, qzs.qq.com, REJECT-DROP
DOMAIN, rmonitor.qq.com, REJECT-DROP
DOMAIN, sdk.e.qq.com, REJECT-DROP
DOMAIN, sdkconfig.video.qq.com, REJECT-DROP
DOMAIN, t.gdt.qq.com, REJECT-DROP
DOMAIN, tmead.y.qq.com, REJECT-DROP
DOMAIN, tmeadbak.y.qq.com, REJECT-DROP
DOMAIN, tmeadcomm.y.qq.com, REJECT-DROP
DOMAIN, tpns.qq.com, REJECT-DROP
DOMAIN, v.gdt.qq.com, REJECT-DROP
DOMAIN, v2.gdt.qq.com, REJECT-DROP
DOMAIN, win.gdt.qq.com, REJECT-DROP
DOMAIN, wup.imtt.qq.com, REJECT-DROP
DOMAIN, tpstelemetry.tencent.com, REJECT-DROP
DOMAIN-KEYWORD, trace.qq.com, REJECT-DROP
DOMAIN-KEYWORD, trace.video.qq.com, REJECT-DROP
DOMAIN-SUFFIX, gdt.qq.com, REJECT-DROP
DOMAIN-SUFFIX, l.qq.com, REJECT-DROP
DOMAIN-SUFFIX, ugdtimg.com, REJECT-DROP
IP-CIDR, 47.110.187.87/32, REJECT-DROP, no-resolve
URL-REGEX, "^http:\/\/y\.gtimg\.cn\/music\/common\/upload\/t_k_main_page_banner\/", REJECT-DROP

[URL Rewrite]
^https:\/\/tmeadkg\.y\.qq\.com\/maproxy\/getAd$ _ reject

[Map Local]
^https:\/\/wallpaper-\d+\.file\.myqcloud\.com\/dsl\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/wallpaper-\d+\.file\.myqcloud\.com\/hikari\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/amsweb-cdn-\S+-\d+\.file\.myqcloud\.com\/video\/ad_profile\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/wnsaviator\.kg\.qq\.com\/wnsaviator\/api\/v1\/transMerge\?_webcgikey=get_activity_entry$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% wallpaper-1258344696.file.myqcloud.com, amsweb-cdn-*-1258344696.file.myqcloud.com, wnsaviator.kg.qq.com, tmeadkg.y.qq.com
