#!name=七猫小说去广告
#!desc=移除大部分七猫小说广告，但受限于七猫小说自身对MitM和VPN状态的检测，部分页面广告无法移除。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id1387717110
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/SevenCat.png
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/SevenCat_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN, cdn-ad.wtzw.com, REJECT-DROP
DOMAIN, cdn-new-ad.wtzw.com, REJECT-DROP
DOMAIN-SUFFIX, gdt.qq.com, REJECT-DROP

[Map Local]
(?i)^https:\/\/api-cfg\.wtzw\.com\/v\d\/splash\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api-bc\.wtzw\.com\/api\/v4\/search\/dispose data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/book-store\/config data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/book-store\/push-book data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/operation data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/ data-type=text data="" status-code=404
(?i)^https:\/\/api-gw\.wtzw\.com\/welf\/app\/v\d\/task\/red-packet data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/cdn\.wtzw\.com\/bookimg\/free\/api\/v\d\/reader\/reader-copy-paragraph-all\.json data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api-cfg\.wtzw\.com\/v\d\/reward\/ data-type=text data="" status-code=404
(?i)^https:\/\/api-cfg\.wtzw\.com\/v\d\/adv\/ data-type=text data="" status-code=404
(?i)^https:\/\/api-cfg\.wtzw\.com\/v\d\/offline-adv\/index data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api-cfg\.wtzw\.com\/v\d\/operation\/index\?ad_personal_switch data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/withdraw\/init data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq (?i)^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/user\/my-center\? 'reduce [["data","func_area",1],["data","func_area",2]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'

[MITM]
hostname = %APPEND% api-cfg.wtzw.com, sf3-fe-tos.pglstatp-toutiao.com, api-bc.wtzw.com, api-gw.wtzw.com, cdn.wtzw.com
