[Map Local]
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetActivityTab data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetBubbles data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetCommonBanner data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/SearchBanner data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.SeasonV\d\/GetSeasonInfo data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/manga\.bilibili\.com\/twirp\/bookshelf\.v\d\.Bookshelf\/ListEmptyRecommend data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/manga\.bilibili\.com\/twirp\/bookshelf\.v\d\.Bookshelf\/NovelRecommend data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/manga\.bilibili\.com\/twirp\/novel\.v\d\.Novel\/MoreRecommend data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetBubbles data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/AppInit data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
移除顶部标签 = type=http-response,pattern=^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetClassPageAllTabs,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/BiliComic/BiliComic_remove_ads.js,requires-body=true
精简我的页面 = type=http-response,pattern=^https:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.User\/UCenterConf,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/BiliComic/BiliComic_remove_ads.js,requires-body=true

[MITM]
hostname = %APPEND% manga.bilibili.com
