#!name=亲宝宝去广告
#!desc=移除开屏广告、弹窗广告、广告下发、用户行为上报，精简搜索页、育儿页和我的页面，拦截商城页面。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id672984826
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Qbb.png
#!date=2026-08-26 11:08:19
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/Qbb_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN, apimall.qbb6.com, REJECT-DROP

[Map Local]
(?i)^https:\/\/api\.qbb6\.com\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/api\.qbb6\.com\/commons\/main\/tab\/info\/get\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/apicommunity\.qbb6\.com\/community\/recommend\/user\/get\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/apipt\.qbb6\.com\/parenting\/pt\/home\/post\/card\/get\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/apipt\.qbb6\.com\/lib\/search\/hot\/keys\/v\d\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/apiuser\.qbb6\.com\/user\/member\/info\/get\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/apimall\.qbb6\.com\/mall\/v\d\/goods\/count\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
(?i)^https:\/\/apimall\.qbb6\.com\/mall\/homepage\/data\/get\/v\d$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
精简我的页面 = type=http-response,pattern=^https:\/\/api\.qbb6\.com\/commons\/self\/button\/group\/get\/v\d\?,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/Qbb/my.js,requires-body=true
精简育儿页面 = type=http-response,pattern=^https:\/\/apipt\.qbb6\.com\/parenting\/pt\/homepage\/get\/v\d\?,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/Qbb/homepage.js,requires-body=true

[MITM]
hostname = %APPEND% api.qbb6.com, apicommunity.qbb6.com, apipt.qbb6.com, apiuser.qbb6.com, apimall.qbb6.com
