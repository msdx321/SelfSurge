#!name=多屏互动去广告
#!desc=移除开屏广告、横幅推广、搜索填充词，移除广告下发。
#!openUrl=https://apps.apple.com/app/id1127750481
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TCLnScreen.png
#!date=2026-07-31 23:26:04

[Map Local]
^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/ads\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/selection\/banner$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/searchrank$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/selection\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/message\/v\d\/activity\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/config\/function\? '.data |= map(select(.module == "tools"))'

[MITM]
hostname = %APPEND% tcast-o.api.leiniao.com
