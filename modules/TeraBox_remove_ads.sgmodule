#!name=TeraBox去广告
#!desc=移除开屏广告、应用内悬浮窗、弹窗广告及横幅广告。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id1509453185
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TeraBox.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/TeraBox_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN, ymg-api.terabox.com, REJECT-DROP

[Map Local]
^https:\/\/www\.terabox\.com\/adx\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/www\.terabox\.com\/api\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/www\.terabox\.com\/api\/page\/tips\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/www\.terabox\.com\/rest\/1\.0\/task\/common\/inttips\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% www.terabox.com
