[URL Rewrite]
^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/h\/headlines\/queryHeadlines _ reject

[Map Local]
^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/update\/startupPage\/v1 data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/config\/guessYouLike\/v3 data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
移除主页推广 = type=http-response,pattern=^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/config\/homeInit\/v3,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/PICC_Insurance/PICC_Insurance_remove_ads.js,requires-body=true
移除我的页面推广 = type=http-response,pattern=^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/mpageconfig\/myPageConfigList\/v3,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/PICC_Insurance/PICC_Insurance_remove_ads.js,requires-body=true

[MITM]
hostname = %APPEND% zgrb.epicc.com.cn
