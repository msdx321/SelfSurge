#!name=好轻去广告
#!desc=移除开屏广告、弹窗广告、横幅推广、商品推广，精简我的页面。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id889565307
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YunmaiScale.png
#!date=2026-07-15 10:19:17
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/YunmaiScale_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Map Local]
^https:\/\/yunmai\.sfo-tx-beijing-02\.saas\.sensorsdata\.cn\/api\/v2\/sfo\/user_popup_configs\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/restapi\.iyunmai\.com\/ad-api\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/apisvr\.iyunmai\.com\/api\/ios\/first-page-module\/center_menu\.json\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/restapi\.iyunmai\.com\/api\/ios\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/apisvr\.iyunmai\.com\/api\/ios\/apps\/get-online-parameter-list\.json\? '.data.rows |= map(select(.name | IN("AC_startTime","AC_endTime","AC_enable","AC_url","AC_challenge_tip","AC_challenge_tip_id","AC_pt_tip","AC_pt_tip_id","AC_pt_go_tmall_jd","month7_activity","AC_xmas_isOpen","home_show_info","new_user_credit_exchange_info","AC_share_recommendUrl","AC_share_recommendUrl_2","AC_share_recommendUrl_3") | not))'

[MITM]
hostname = %APPEND% yunmai.sfo-tx-beijing-02.saas.sensorsdata.cn, apisvr.iyunmai.com, restapi.iyunmai.com
