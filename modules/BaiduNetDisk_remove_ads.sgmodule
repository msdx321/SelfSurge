#!name=百度网盘去广告
#!desc=移除开屏广告、首页卡片广告、传输页面广告、各类弹窗，精简侧拉抽屉和我的页面。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id547166701
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BaiduNetDisk.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/BaiduNetDisk_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Map Local]
^https:\/\/pan\.baidu\.com\/api\/getconfig\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/pan\.baidu\.com\/api\/getsyscfg\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/pan\.baidu\.com\/api\/taskscore\/tasklist\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/pan\.baidu\.com\/act\/api\/activityentry\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/pan\.baidu\.com\/rest\/\d\.\d\/pcs\/adv\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/pan\.baidu\.com\/api\/plugin\/get\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/pan\.baidu\.com\/recommend\/query\/list\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/pan\.baidu\.com\/feed\/kingkongdistrict\? '.data.data |= map(select(.type != "novel" and .type != "shortplay" and .type != "print" and .type != "job_hunt"))'

[MITM]
hostname = %APPEND% pan.baidu.com
