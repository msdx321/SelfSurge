#!name=叮咚买菜去广告
#!desc=移除开屏广告、弹窗推广、搜索推荐、信息流广告、悬浮广告、各页面购物推荐、精简我的页面，移除底栏和各页面AI入口。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id768082524
#!author=zirawell[https://github.com/zirawell], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], wish
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DingdongMaicai.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/DingdongMaicai_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN, trackercollect.ddxq.mobi, REJECT-DROP
DOMAIN, ddfs-public.ddimg.mobi, REJECT-DROP
DOMAIN, rttrack.ddxq.mobi, REJECT-DROP

[URL Rewrite]
^https?:\/\/maicai\.api\.ddxq\.mobi\/advert\/ _ reject
^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/getHomeAdPop _ reject

[Map Local]
^https?:\/\/119\.29\.29\.\d+\/d data-type=text data="" status-code=200
^https:\/\/maicai\.api\.ddxq\.mobi\/vip\/getVipAd\/\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/marketingNotice\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/maicai\.api\.ddxq\.mobi\/search\/rollHotKeyword\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/maicai\.api\.ddxq\.mobi\/search\/rankingList\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/maicai\.api\.ddxq\.mobi\/search\/hotKeyword\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/maicai\.api\.ddxq\.mobi\/order\/getRecommend$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/userLike\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/user\.api\.ddxq\.mobi\/userportal-service\/api\/v1\/user\/queryMyPage\/\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/maicai\.api\.ddxq\.mobi\/guide-service\/userLike\/flowData$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/categoriesNewDetail\? 'reduce [["data","ad_info"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/maicai\.api\.ddxq\.mobi\/tool\/getConfig\? 'reduce [["data","ai_enter_config"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails\? 'reduce [["data","top_advert_data"],["data","suspension"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails\? '.data.list |= map(select(has("capsule_freedom_zone") | not))'
http-response-jq ^https:\/\/maicai\.api\.ddxq\.mobi\/guide-service\/productApi\/productDetail\/info\? 'reduce [["data","detail","chatEntry"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/bottomNavi 'del(.data.adId?) | if (.data.bottom_list? | length > 0) then .data.bottom_list |= map(select(.type != "eatwhat")) else . end'
http-response-jq ^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/homeFlowDetail 'walk( if type == "object" and has("list") then .list |= map( if type == "object" and has("multi_advertise_data_list") then del(.multi_advertise_data_list) else . end ) else . end )'

[MITM]
hostname = %APPEND% 119.29.29.*, maicai.api.ddxq.mobi, user.api.ddxq.mobi
