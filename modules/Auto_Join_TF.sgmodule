#!name=自动加入TestFlight
#!desc=自动监控TestFlight名额，一旦有新的名额即刻加入。
#!openUrl=https://apps.apple.com/app/id899247664
#!author=奶思[https://github.com/fmz200], DecoAri[https://github.com/DecoAri], xream[https://github.com/xream]
#!category=定时任务
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TestFlight.png
# Loon metadata: #!input=App_ID
#!date=2026-06-01 17:11:35

#!arguments=CaptureAccountToken:false,RunTask:false,RunMonitor:true,TaskCron:0 0/2 * * * ?,TaskMonitor:0 * * * * ?
#!arguments-desc=Loon 选项已转为自由输入；可选值见模块注释；enable 值作为脚本最后一个参数传入。
# Surge 参数 CaptureAccountToken：默认 false；可选 false | true；捕获账号令牌；此开关控制插件是否捕获账户令牌
# Surge 参数 RunTask：默认 false；可选 false | true；自动加入TF；此开关控制是否启动定时任务
# Surge 参数 RunMonitor：默认 true；可选 true | false；监控TF位置；此开关控制是否启动定时任务
# Surge 参数 TaskCron：默认 0 0/2 * * * ?；加入TF定时参数；这里需要输入符合CRON表达式的参数
# Surge 参数 TaskMonitor：默认 0 * * * * ?；监控TF定时参数；这里需要输入符合CRON表达式的参数

[Rule]
# Unsupported Loon policy PROXY: DOMAIN, testflight.apple.com, PROXY

[Script]
# Loon enable 参数 CaptureAccountToken 已作为最后一个脚本参数传入；脚本需读取该值并在 false 时直接退出。
获取账号令牌 = type=http-request,pattern=^https?:\/\/testflight\.apple\.com\/v3\/accounts\/.*\/apps$,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/TestFlight/CaptureAccountToken.js,argument="{{{CaptureAccountToken}}}"
# Loon enable 参数 RunTask 已作为最后一个脚本参数传入；脚本需读取该值并在 false 时直接退出。
自动加入TF = type=cron,cronexp="{{{TaskCron}}}",script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/TestFlight/AutoJoinTF.js,timeout=600,argument="{{{RunTask}}}"
# Loon enable 参数 RunMonitor 已作为最后一个脚本参数传入；脚本需读取该值并在 false 时直接退出。
监控TF位置 = type=cron,cronexp="{{{TaskMonitor}}}",script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/TestFlight/AutoMonitorTF.js,timeout=30,argument="{{{RunMonitor}}}"
