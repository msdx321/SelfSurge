#!name=WPS每日签到
#!desc=WPS每日签到并兑换会员，需要进入此插件的主页链接，阅读使用说明操作。
#!category=签到
#!openUrl=https://apps.apple.com/app/id599852710
#!author=小白脸
#!homepage=https://github.com/luestr/ProxyResource/blob/main/Resource/Markdown/WPS/README.md
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/WPS.png
#!date=2026-06-01 17:11:35
#!arguments=CaptureCookie:false,AK:,SK:,DAY:1,MAX_RETRIES:5,CRONEXP:0 8 * * *
#!arguments-desc=Loon 选项与策略已转为 Surge 自由输入；脚本参数按同名字段传入，具体格式见模块注释；enable 字段为 false 时脚本需立即退出。

# Source: https://kelee.one/Tool/Loon/Lpx/WPS_checkin.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

# Surge 参数 CaptureCookie：默认 false；可选 false | true；捕获Cookie；此开关控制插件是否捕获Cookie
# Surge 参数 AK：默认 ；百度API Key；这里需要输入有效的百度API Key
# Surge 参数 SK：默认 ；百度Secret Key；这里需要输入有效的百度Secret Key
# Surge 参数 DAY：默认 1；兑换天数；每日签到时自动兑换的天数，可不做更改。
# Surge 参数 MAX_RETRIES：默认 5；失败重试次数；仅允许填写阿拉伯数字
# Surge 参数 CRONEXP：默认 0 8 * * *；定时参数；这里需要输入符合CRON表达式的参数

[Script]
# Loon enable 参数 CaptureCookie 已作为同名脚本参数字段传入；脚本需在 false 时直接退出。
捕获Cookie = type=http-request,pattern=^https:\/\/moapi\.wps\.cn\/app\/ios\/v1\/app$,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/WPS/WPS_checkin.js,requires-body=true,argument="CaptureCookie={{{CaptureCookie}}}"
WPS每日签到 = type=cron,cronexp="{{{CRONEXP}}}",script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/WPS/WPS_checkin.js,timeout=120,argument="AK={{{AK}}}&SK={{{SK}}}&MAX_RETRIES={{{MAX_RETRIES}}}"

[MITM]
hostname = %APPEND% moapi.wps.cn
