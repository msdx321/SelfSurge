#!name=5EPlay去广告
#!desc=移除开屏广告、弹窗广告、活动角标、商城。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id1149334962
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/5EPlay.png
#!date=2026-08-24 18:59:19
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/5EPlay_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Map Local]
^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/kwd_top$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? 'reduce [["data","function_configs","startup_ad_switch"],["data","function_configs","startup_ad_timeout"],["data","function_configs","startup_ad_day_max"],["data","function_configs","app_bar_guide_width"],["data","function_configs","app_bar_guide_height"],["data","function_configs","app_bar_guide_url"],["data","function_configs","app_bar_guide_time"],["data","function_configs","home_tab_event_tag"],["data","function_configs","home_tab_event_tag_ext"],["data","function_configs","home_tab_player_tag"],["data","function_configs","home_tab_player_tag_ext"],["data","function_configs","task_center_entrance"],["data","function_configs","store_go"],["data","function_configs","wall_closed"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/app\.5eplay\.com\/api\/index\/tab_v\d\?category_id=tab_1&page=\d$ 'reduce [["data","float_advertise"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/config$ 'reduce [["data","placeholder"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'

[MITM]
hostname = %APPEND% app.5eplay.com, ya-api-app.5eplay.com
