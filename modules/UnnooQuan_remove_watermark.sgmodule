#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/UnnooQuan_remove_watermark.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Body Rewrite]
http-response-jq ^https:\/\/api\.zsxq\.com\/v2\/groups\/\d+$ 'reduce [[["resp_data","group","policies","enable_watermark"],["resp_data","group","policies"],"enable_watermark",false]][] as $item (.;. as $before | try (if (getpath($item[1]) | has($item[2])) then setpath($item[0];$item[3]) else . end) catch $before)'
http-response ^https:\/\/articles\.zsxq\.com\/inline_form\/id_[a-z0-9]+\.html name="group_enable_watermark"\x20value="true" name="group_enable_watermark"\x20value="false"

[MITM]
hostname = %APPEND% api.zsxq.com
