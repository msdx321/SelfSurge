#!name=什么值得买去广告
#!desc=移除开屏广告、信息流广告、各类横幅广告、搜索页广告、文章内广告，移除活动皮肤、精简我的页面。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id518213356
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/smzdm.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/smzdm_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN, adx-api.zdmimg.com, REJECT

[URL Rewrite]
^https:\/\/h5\.smzdm\.com\/user\/coupon\/coupon_list\? _ reject

[Map Local]
^https:\/\/app-api\.smzdm\.com\/util\/loading\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/app-api\.smzdm\.com\/mychannel\/list$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/user-api\.smzdm\.com\/vip\/bottom_card_list\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/article-api\.smzdm\.com\/publish\/get_bubble\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/s-api\.smzdm\.com\/sou\/search_default_keyword\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/s-api\.smzdm\.com\/sou\/popup_coupon\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/app-api\.smzdm\.com\/util\/update$ 'reduce [[["data","silence_local_push"],["data"],"silence_local_push",0],[["data","baichuan_redirect_switch"],["data"],"baichuan_redirect_switch",0]][] as $item (.;. as $before | try (if (getpath($item[1]) | has($item[2])) then setpath($item[0];$item[3]) else . end) catch $before)'
http-response-jq ^https:\/\/app-api\.smzdm\.com\/util\/update$ 'reduce [["data","silence_local_push_msg"],["data","video_cache_num_configs"],["data","haojia_widget"],["data","widget"],["data","operation_float"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/app-api\.smzdm\.com\/util\/update$ 'def r: if type=="object" then if has("ad_campaign_name") and (.ad_campaign_name|type=="string") and (.ad_campaign_name|test("\\S")) then empty else . end elif type=="array" then map(r) else . end; .data.operation_float |= map(map(r))'
http-response-jq ^https:\/\/homepage-api\.smzdm\.com\/v3\/home\? '.data.component |= map( if (.zz_content | type) == "array" then .zz_content |= map( select( ( (.ad_campaign_id? | type == "string" and length > 0)// false ) or ( (.tag? | type == "string" and length > 0)// false ) or ( (.model_type? == "ads" and (type == "string"))// false ) | not ) ) else . end ) | .data.component |= map( select(.zz_type == "circular_banner" or .zz_type == "filter" or .zz_type == "list") ) | .data.component |= map( .zz_content |= ( if type == "array" then map( if type == "object" and (.article_channel_type// "") == "questionnaire" then empty else . end ) else . end ) ) | del(.data.theme) | .data.component |= map( if .zz_content | type == "object" then .zz_content |= del(.circular_banner_option) else . end )'
http-response-jq ^https:\/\/haojia-api\.smzdm\.com\/home\/list\? 'reduce [["data","header_operation","theme"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/haojia-api\.smzdm\.com\/home\/list\? '.data.rows |= map(select(.cell_type == "39001")) | .data.banner_v2 |= map(select(.cell_type == "21028"))'
http-response-jq ^https:\/\/haojia\.m\.smzdm\.com\/detail_modul\/user_related_modul\? 'reduce [["data","super_coupon"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/haojia\.m\.smzdm\.com\/detail_modul\/other_modul\? 'reduce [["data","banner"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/user-api\.smzdm\.com\/vip$ 'reduce [["data","activity_entrance_info"],["data","big_banner"],["data","top_banner"],["data","banner_switch"],["data","yaoqingshaiwu"],["data","right_info"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/s-api\.smzdm\.com\/sou\/list_v10\? '.data.rows |= map(select(.model_type != "ads")) | .data.top_aladdin |= map(select(has("ad") | not))'
http-response-jq ^https:\/\/s-api\.smzdm\.com\/sou\/filter\/tags\/hot_tags\? 'reduce [["data","search_faxian"],["data","tonglan"],["data","hongbao"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/s-api\.smzdm\.com\/sou\/filter\/tags\/hot_tags\? '.data.hot_tab |= ( if type == "array" then map(select(.search_method != "热点主题榜")) else . end ) | if .data.hot_tab then .data.hot_tab |= map( if .search_method == "热搜榜搜索热榜" and .rows then .rows |= map(select(.pos != null and ((.pos | tonumber) != null))) else . end ) else . end'
http-response-jq ^https:\/\/haojia-api\.smzdm\.com\/detail\/\d+\? 'reduce [["data","quan_log"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/haojia-cdn\.smzdm\.com\/preload\/\d+\/fiphone\/v\d+_\d+_\d+\/wx\d+\/im\d+\/[0-9a-z]+\/[0-9a-z]+\.json$ 'reduce [["data","quan_log"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/post\.m\.smzdm\.com\/ajax_app\/ajax_get_footer_list\? 'reduce [["data","tuiguang_ad"],["data","activity_banner"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'

[MITM]
hostname = %APPEND% app-api.smzdm.com, homepage-api.smzdm.com, h5.smzdm.com, haojia-api.smzdm.com, haojia.m.smzdm.com, user-api.smzdm.com, article-api.smzdm.com, s-api.smzdm.com, haojia-cdn.smzdm.com, post.m.smzdm.com
