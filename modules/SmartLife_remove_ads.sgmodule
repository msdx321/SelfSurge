[Map Local]
^https:\/\/i\.ilife798\.com\/api\/v\d\/acc\/score\/mission-lst$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/i\.ilife798\.com\/api\/v\d\/ep\/lst-simple\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/i\.ilife798\.com\/api\/v\d\/ui\/app\/master$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/i\.ilife798\.com\/api\/v\d\/acc\/login$ 'delpaths([["data","ar"],["data","showAd"]])'

[MITM]
hostname = %APPEND% i.ilife798.com
