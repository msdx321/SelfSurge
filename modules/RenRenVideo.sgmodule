# Source: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Surge/module/split/partR/RenRenVideo.sgmodule
# Modified by SelfSurge: normalized metadata, jq syntax, and resource URLs.
# License: GPL-3.0; see resources/licenses/fmz200-wool_scripts-LICENSE.
#############################################



[Rule]
DOMAIN-SUFFIX,ad.rr.tv,REJECT
DOMAIN-SUFFIX,ebp.renren.com,REJECT
DOMAIN-SUFFIX,jebe.renren.com,REJECT
DOMAIN-SUFFIX,bolt.jebe.renren.com,REJECT
DOMAIN-SUFFIX,cupid.jebe.renren.com,REJECT
DOMAIN-SUFFIX,shaft.jebe.renren.com,REJECT
DOMAIN-SUFFIX,xray.jebe.renren.com,REJECT

[URL Rewrite]
# RRTV_屏蔽軟件更新
^https?:\/\/api\.rr\.tv\/.*?Version - reject

[Map Local]
# RRTV_屏蔽限時彈窗
https://api.rr.tv/storage/business/rootName/app/homePage\?dataType=JSON data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# RRTV_level_info
RenRenVideo-33 = type=http-response, pattern=^https?:\/\/api\.rr\.tv\/\w{3}\/level\/info, script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/upstream/26050e48827affcf.js, requires-body=true, timeout=60

# RRTV_去除首頁廣告
RenRenVideo-36 = type=http-response, pattern=https://api.rr.tv/v3plus/index/channel\?pageNum=1&position=CHANNEL_INDEX, script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/upstream/26050e48827affcf.js, requires-body=true, timeout=60

# RRTV_去除廣場tab
RenRenVideo-39 = type=http-response, pattern=^https?:\/\/api\.rr\.tv\/app\/config\/h5NativeBar, script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/upstream/26050e48827affcf.js, requires-body=true, timeout=60

# RRTV_去除商城廣告
RenRenVideo-42 = type=http-response, pattern=^https?:\/\/api\.rr\.tv\/v3plus\/index\/channel\?pageNum=1&position=CHANNEL_MY, script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/upstream/26050e48827affcf.js, requires-body=true, timeout=60

# RRTV_Ad_List
RenRenVideo-45 = type=http-response, pattern=^https?:\/\/api\.rr\.tv\/user\/privilege\/list, script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/upstream/26050e48827affcf.js, requires-body=true, timeout=60

# RRTV_Ad_All
RenRenVideo-48 = type=http-response, pattern=^https?:\/\/api\.rr\.tv\/ad\/getAll, script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/upstream/26050e48827affcf.js, requires-body=true, timeout=60

# RRTV_Get_Drama
RenRenVideo-51 = type=http-response, pattern=^https?:\/\/api\.rr\.tv\/drama\/app\/get_combined_drama_detail, script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/upstream/26050e48827affcf.js, requires-body=true, timeout=60

# RRTV_Watch_V4
RenRenVideo-54 = type=http-response, pattern=https://api.rr.tv/watch/v4, script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/upstream/26050e48827affcf.js, requires-body=true, timeout=60

# RRTV_User_Info
RenRenVideo-57 = type=http-response, pattern=https://api.rr.tv/user/profile, script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/upstream/26050e48827affcf.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% api.rr.tv
