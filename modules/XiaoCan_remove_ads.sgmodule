[Map Local]
^https:\/\/web2\.realtech-inc\.com\/oss\/xc-app-assets\/configs\/common\/theme\.json data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/sdk\.1rtb\.net\/sdk\/req_ad\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/gw\.xiaocantech\.com\/g\/pa data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Header Rewrite]
http-request ^https:\/\/gw\.xiaocantech\.com\/rpc header-replace-regex methodname .*(GetBannerList|IsShowOrderAwardPopup|UserLifeShopList|BrandBannerList|GetPromotionGlobalCfg) null

[MITM]
hostname = %APPEND% gw.xiaocantech.com, web2.realtech-inc.com, sdk.1rtb.net
