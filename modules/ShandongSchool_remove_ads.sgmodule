[Map Local]
^https:\/\/api\.huachenjie\.com\/run-front\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.huachenjie\.com\/run-front\/api\/union\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.huachenjie\.com\/run-front\/home\/getAdPopup$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.huachenjie\.com\/run-front\/street\/listRecommendBanner$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.huachenjie\.com\/run-front\/street\/listThemeBanner$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.huachenjie\.com\/run-front\/api\/home\/activityEntry$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.huachenjie\.com\/run-front\/home\/promoSlots\/config$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.huachenjie\.com\/run-front\/api\/channel\/subject\/hotspot\/rank$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.huachenjie\.com\/run-front\/api\/jackpot\/award\/home$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.huachenjie\.com\/run-front\/api\/jackpot\/award\/lotteryPage$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.huachenjie\.com\/run-front\/api\/jackpot\/award\/list$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/api\.huachenjie\.com\/run-front\/api\/mall\/goods\/recommend\/pagePointsGoodsList$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/api\.huachenjie\.com\/run-front\/home\/homePage\/config$ '.data.functionEntries |= map(select(.name == "运动" or .name == "空间")) | del(.data.seaview)'
http-response-jq ^https:\/\/api\.huachenjie\.com\/run-front\/api\/user\/cs\/index$ 'reduce [["data","bannerList"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/api\.huachenjie\.com\/run-front\/common\/bottom-bar\/redDot$ 'reduce [["data","inspiration"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'

[MITM]
hostname = %APPEND% api.huachenjie.com
