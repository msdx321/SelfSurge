#!name=Jump去广告
#!desc=移除Jump开屏广告
#!category=去广告
#!openUrl=https://apps.apple.com/app/id1529434108
#!author=MoonYuki[https://github.com/MoonYuki]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Jump.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/Jump_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN, zlsdk.1rtb.net, REJECT-DROP
DOMAIN, jp.ad.gameley.com, REJECT-DROP
DOMAIN, toblog.ctobsnssdk.com, REJECT-DROP
DOMAIN, s3plus.meituan.net, REJECT-DROP
DOMAIN, images.pinduoduo.com, REJECT-DROP
DOMAIN, qh-material.taobao.com, REJECT-DROP
DOMAIN-SUFFIX, admobile.top, REJECT-DROP

[Body Rewrite]
http-response-jq ^https:?\/\/switch.jumpvg.com\/jump\/getlaunchad\/v2$ 'del(.data.adList)|.data.launchAd.showType=0'
http-response-jq ^https:?\/\/switch.jumpvg.com\/jump\/recommend\/ad_conf$ '.data=[]'

[MITM]
hostname = %APPEND% switch.jumpvg.com
