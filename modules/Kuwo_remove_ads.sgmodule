[Rule]
# Converted to rewrite: URL-REGEX, "^http:\/\/rich\.kuwo\.cn\/AdService\/", REJECT-DICT
# Converted to rewrite: URL-REGEX, "^http:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/user\/freeMode\/", REJECT-DICT
# Converted to rewrite: URL-REGEX, "^http:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/app\/pasterAdvert\/", REJECT-DICT
# Converted to rewrite: URL-REGEX, "^http:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/app\/startup\/config", REJECT-DICT
# Converted to rewrite: URL-REGEX, "^http:\/\/rich\.kuwo\.cn\/EcomResourceServer\/", REJECT-DICT
IP-CIDR, 111.206.98.63/32, REJECT, no-resolve
# Converted to rewrite: URL-REGEX, "^http:\/\/searchrecterm\.kuwo\.cn\/recterm\.s", REJECT-DICT
# Converted to rewrite: URL-REGEX, "^http:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/app\/newMenuList\/menuListInfo", REJECT-DICT
# Converted to rewrite: URL-REGEX, "^http:\/\/vip\d\.kuwo\.cn\/vip\/v\d\/sysinfo\?op=getRePayAndDoPayBox", REJECT-DICT
# Converted to rewrite: URL-REGEX, "^http:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/album\/adBar\/", REJECT-DICT

[Map Local]
"^http:\/\/rich\.kuwo\.cn\/AdService\/" data-type=text data="{}" header="Content-Type:application/json" status-code=200
"^http:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/user\/freeMode\/" data-type=text data="{}" header="Content-Type:application/json" status-code=200
"^http:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/app\/pasterAdvert\/" data-type=text data="{}" header="Content-Type:application/json" status-code=200
"^http:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/app\/startup\/config" data-type=text data="{}" header="Content-Type:application/json" status-code=200
"^http:\/\/rich\.kuwo\.cn\/EcomResourceServer\/" data-type=text data="{}" header="Content-Type:application/json" status-code=200
"^http:\/\/searchrecterm\.kuwo\.cn\/recterm\.s" data-type=text data="{}" header="Content-Type:application/json" status-code=200
"^http:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/app\/newMenuList\/menuListInfo" data-type=text data="{}" header="Content-Type:application/json" status-code=200
"^http:\/\/vip\d\.kuwo\.cn\/vip\/v\d\/sysinfo\?op=getRePayAndDoPayBox" data-type=text data="{}" header="Content-Type:application/json" status-code=200
"^http:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/album\/adBar\/" data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/vip\d\.kuwo\.cn\/commercia\/vipconf\/projectPage\/getPageContent data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/tingshu\.kuwo\.cn\/v2\/api\/pay\/user\/info data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/appi\.kuwo\.cn\/kuwopay\/personal\/cells data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^http:\/\/wapi\.kuwo\.cn\/openapi\/v\d\/tingshu\/index\/radio 'walk( if type == "object" and .type == "stripAdvert" then del(.child) else . end )'

[MITM]
hostname = %APPEND% appi.kuwo.cn, mc.tencentmusic.com, vip*.kuwo.cn, tingshu.kuwo.cn
