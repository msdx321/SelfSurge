#!name=得间小说去广告
#!desc=移除开屏广告、章末广告，移除扉页广告提示、听书界面广告提示、搜索栏填充词。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id1454487240
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/iReaderDejian.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/iReaderDejian_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN, smad.ms.zhangyue.net, REJECT-DROP
DOMAIN, saad.ms.zhangyue.net, REJECT-DROP

[Map Local]
^https:\/\/dj\.palmestore\.com\/djad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/dj\.palmestore\.com\/zybk\/api\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/dj\.palmestore\.com\/zyapi\/bookstore\/ad\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/dj\.palmestore\.com\/zybk\/api\/bookshelf\/index\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/dj\.palmestore\.com\/zybk\/api\/powerup\/userGroup\? 'reduce [["body","sevenDaysAd"],["body","shortPlayShow"],["body","sdkShortPlayAB"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'
http-response-jq ^https:\/\/dj\.palmestore\.com\/zybk\/api\/search\/index\? 'reduce [["body","keywords"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'

[MITM]
hostname = %APPEND% dj.palmestore.com
