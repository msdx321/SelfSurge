#!name=腾讯视频去广告
#!desc=过滤腾讯视频客户端广告，如遇失效，则需要重新安装腾讯视频客户端。由于此插件不再维护，客户端版本高于8.9.40可能会导致此插件失效，请勿升级客户端。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id458318329
#!author=RuCu6[https://github.com/RuCu6]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Tencent_Video.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/Tencent_Video_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN, adsmind.gdtimg.com, REJECT-DROP
DOMAIN, info4.video.qq.com, REJECT-DROP
DOMAIN, info6.video.qq.com, REJECT-DROP
DOMAIN, ios.video.mpush.qq.com, REJECT-DROP
DOMAIN, otheve.beacon.qq.com, REJECT-DROP
DOMAIN, pgdt.gtimg.cn, REJECT-DROP
DOMAIN, tpns.qq.com, REJECT-DROP
DOMAIN, vv6.video.qq.com, REJECT-DROP
DOMAIN-SUFFIX, gdt.qq.com, REJECT-DROP
DOMAIN-SUFFIX, l.qq.com, REJECT-DROP
DOMAIN-KEYWORD, trace.qq.com, REJECT-DROP
DOMAIN-KEYWORD, trace.video.qq.com, REJECT-DROP
IP-CIDR, 47.110.187.87/32, REJECT-DROP, no-resolve
URL-REGEX, "^http:\/\/[\d\.:]*\/?(defaultts\.tc|vmind\.qqvideo\.tc|finderpdd\.video)\.qq\.com\/\w+", REJECT-DROP
URL-REGEX, "^http:\/\/apd-vlive\.apdcdn\.tc\.qq\.com\/vmind\.qqvideo\.tc\.qq\.com\/\w+", REJECT-DROP
URL-REGEX, "^http:\/\/apd-\w+\.v\.smtcdns\.com\/(defaultts|omts|vmind\.qqvideo)\.tc\.qq\.com\/\w+", REJECT-DROP

[Map Local]
^https?:\/\/vv\.video\.qq\.com\/(diff|get)vmind data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Script]
移除广告 = type=http-request,pattern=^https?:\/\/vv\.video\.qq\.com\/getvinfo,script-path=https://kelee.one/Resource/JavaScript/CommonScript/replace-body.js,requires-body=true,argument="&sppreviewtype=\d(.*)&spsrt=\d->&sppreviewtype=0$1&spsrt=0"

[MITM]
hostname = %APPEND% vv.video.qq.com
