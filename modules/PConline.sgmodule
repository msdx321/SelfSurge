[Rule]
DOMAIN-SUFFIX,iad0ssl.pcauto.com.cn,REJECT
DOMAIN-SUFFIX,imgad0.pcauto.com.cn,REJECT
DOMAIN-SUFFIX,ivy.pcauto.com.cn,REJECT
DOMAIN-SUFFIX,ivy.pcbaby.com.cn,REJECT
DOMAIN-SUFFIX,ivy.pchouse.com.cn,REJECT
DOMAIN-SUFFIX,ivy.pclady.com.cn,REJECT
DOMAIN-SUFFIX,ad-analysis.pconline.com.cn,REJECT
DOMAIN-SUFFIX,count5.pconline.com.cn,REJECT
DOMAIN-SUFFIX,count6.pconline.com.cn,REJECT
DOMAIN-SUFFIX,iad0ssl.pconline.com.cn,REJECT
DOMAIN-SUFFIX,imgad0.pconline.com.cn,REJECT
DOMAIN-SUFFIX,ivy.pconline.com.cn,REJECT

[URL Rewrite]
^https?:\/\/agent-count\.pconline\.com\.cn\/counter\/adAnalyse\/ - reject
^https?:\/\/mrobot\.(pcauto|pconline)\.com\.cn\/v\d\/ad\dp - reject
^https?:\/\/mrobot\.pcauto\.com\.cn\/xsp\/s\/auto\/info\/(ad|preload) - reject

[Map Local]
^https?:\/\/mrobot\.pconline\.com\.cn\/s\/onlineinfo\/ad\/ data-type=text data=" " status-code=200

[MITM]
hostname = %APPEND% mrobot.pconline.com.cn, mrobot.pcauto.com.cn, agent-count.pconline.com.cn
