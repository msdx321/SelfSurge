#!name=Apple天气增强
#!desc=解锁Apple天气的全部功能、替换空气质量数据源、添加下一小时降水数据、添加天气数据。
#!category=功能增强
#!openUrl=https://itunes.apple.com/app/id1069513131
#!author=VirgilClyne[https://github.com/VirgilClyne], WordlessEcho[https://github.com/WordlessEcho], 001[https://github.com/001ProMax]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/AppleWeather.png
#!date=2026-06-01 17:11:35
#!arguments=Weather_Provider:ColorfulClouds,NextHour_Provider:ColorfulClouds,AirQuality_Calculate_Algorithm:EU_EAQI,API_ColorfulClouds_Token:,API_QWeather_Host:devapi.qweather.com,API_QWeather_Token:,API_WAQI_Token:,Storage:Argument,LogLevel:WARN
#!arguments-desc=Loon 选项与策略已转为 Surge 自由输入；脚本参数按同名字段传入，具体格式见模块注释；enable 字段为 false 时脚本需立即退出。

# Source: https://kelee.one/Tool/Loon/Lpx/AppleWeatherEnhancer.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

# Surge 参数 Weather_Provider：默认 ColorfulClouds；可选 ColorfulClouds | WeatherKit | QWeather；[天气]数据源；使用选定的数据源替换天气数据。
# Surge 参数 NextHour_Provider：默认 ColorfulClouds；可选 ColorfulClouds | WeatherKit | QWeather；[未来一小时降水强度]数据源；使用选定的数据源填充未来一小时降水强度的数据。
# Surge 参数 AirQuality_Calculate_Algorithm：默认 EU_EAQI；可选 EU_EAQI | None | UBA | WAQI_InstantCast_US | WAQI_InstantCast_CN | WAQI_InstantCast_CN_25_DRAFT；AQI算法；使用内置算法，通过污染物数据本地计算空气指数。InstantCast源自于WAQI，美标版本使用了WAQI的臭氧标准。
# Surge 参数 API_ColorfulClouds_Token：默认 ；[API]彩云天气令牌；彩云天气API令牌
# Surge 参数 API_QWeather_Host：默认 devapi.qweather.com；[API]和风天气主机；和风天气API使用的主机名
# Surge 参数 API_QWeather_Token：默认 ；[API]和风天气令牌；和风天气API令牌
# Surge 参数 API_WAQI_Token：默认 ；[API]WAQI令牌；WAQI API令牌，填写此字段将自动使用WAQI高级API
# Surge 参数 Storage：默认 Argument；可选 Argument | PersistentStore | database；[储存]配置类型；选择要使用的配置类型。未设置此选项或不通过此选项的旧版本的配置顺序依旧是$persistentStore (BoxJs) > $argument > database。
# Surge 参数 LogLevel：默认 WARN；可选 WARN | OFF | ERROR | INFO | DEBUG | ALL；[调试]日志等级；选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rule]
DOMAIN, weather-analytics-events.apple.com, REJECT-DROP
DOMAIN, tether.edge.apple, REJECT-DROP
DOMAIN-SUFFIX, tthr.apple.com, REJECT-DROP
AND, ((OR, ((IP-ASN, 714, no-resolve), (IP-ASN, 6185, no-resolve))), (PROTOCOL, QUIC)), REJECT-DROP

[Script]
天气可用性响应 = type=http-response,pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/,script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.1.0/response.bundle.js,requires-body=true,argument="Weather.Provider={{{Weather_Provider}}}&NextHour.Provider={{{NextHour_Provider}}}&AirQuality.Calculate.Algorithm={{{AirQuality_Calculate_Algorithm}}}&API.ColorfulClouds.Token={{{API_ColorfulClouds_Token}}}&API.QWeather.Host={{{API_QWeather_Host}}}&API.QWeather.Token={{{API_QWeather_Token}}}&API.WAQI.Token={{{API_WAQI_Token}}}&Storage={{{Storage}}}&LogLevel={{{LogLevel}}}"
天气响应 = type=http-response,pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/,script-path=https://github.com/NSRingo/WeatherKit/releases/download/v3.1.0/response.bundle.js,requires-body=true,binary-body-mode=true,argument="Weather.Provider={{{Weather_Provider}}}&NextHour.Provider={{{NextHour_Provider}}}&AirQuality.Calculate.Algorithm={{{AirQuality_Calculate_Algorithm}}}&API.ColorfulClouds.Token={{{API_ColorfulClouds_Token}}}&API.QWeather.Host={{{API_QWeather_Host}}}&API.QWeather.Token={{{API_QWeather_Token}}}&API.WAQI.Token={{{API_WAQI_Token}}}&Storage={{{Storage}}}&LogLevel={{{LogLevel}}}"

[MITM]
hostname = %APPEND% weatherkit.apple.com
