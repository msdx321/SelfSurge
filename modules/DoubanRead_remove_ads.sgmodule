[Map Local]
^https:\/\/read\.douban\.com\/api\/v2\/ads\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/read\.douban\.com\/api\/v2\/popup$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/read\.douban\.com\/api\/v2\/search\/hot_words$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/read\.douban\.com\/api\/v2\/search\/hot_charts$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/read\.douban\.com\/api\/v2\/search\/rec_urls$ data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% read.douban.com
