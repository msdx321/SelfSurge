[URL Rewrite]
^https:\/\/jx3comm\.xoyocdn\.com\/jx3gc\/zhcn\/login_ad\/WebCareer\/WebCareerTab\.txt _ reject

[MITM]
hostname = %APPEND% jx3comm.xoyocdn.com
