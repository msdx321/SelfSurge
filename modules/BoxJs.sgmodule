#!name=BoxJs
#!desc=JavaScript数据管理器，用于管理脚本储存的数据。使用前请在本插件的详情页面为[PROXY]项分配代理策略。 注意：PROXY 规则需在 Surge 主配置中手动指定策略。
#!category=数据管理
#!openUrl=http://boxjs.com
#!author=chavyleung[https://github.com/chavyleung]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/BoxJS.png
#!date=2026-06-01 17:11:35

# Source: https://kelee.one/Tool/Loon/Lpx/BoxJs.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
# Requires main-profile policy selection: DOMAIN-SUFFIX, jsdelivr.net, PROXY

[Script]
BoxJS = type=http-request,pattern=^https?:\/\/(.+\.)?boxjs\.(com|net),script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/box/chavy.boxjs.js,requires-body=true,timeout=120

[MITM]
hostname = %APPEND% boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net
