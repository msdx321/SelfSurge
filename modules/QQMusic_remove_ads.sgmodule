[Rule]
DOMAIN, adstats.tencentmusic.com, REJECT-DROP
DOMAIN, ad.tencentmusic.com, REJECT-DROP
DOMAIN, adcdn.tencentmusic.com, REJECT-DROP
DOMAIN, adcdn6.tencentmusic.com, REJECT-DROP
DOMAIN, adexpo.tencentmusic.com, REJECT-DROP
DOMAIN, adclick.tencentmusic.com, REJECT-DROP
DOMAIN, mc.tencentmusic.com, REJECT-DROP
DOMAIN, monitor.music.qq.com, REJECT-DROP
DOMAIN, tmead.y.qq.com, REJECT-DROP
DOMAIN, tmeadbak.y.qq.com, REJECT-DROP
DOMAIN, tmeadquic.y.qq.com, REJECT-DROP
