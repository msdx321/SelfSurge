#!name=成分喵去广告
#!desc=移除首页推广活动、广告组件请求、移除被查商品购买链接、搜索发现。
#!openUrl=https://apps.apple.com/app/id6444000785
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!category=去广告
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ChengFenMiao.png
#!date=2026-06-01 17:11:35

[Map Local]
^https:\/\/app\.chengfenmiao\.com\/Listing\/LiveHots\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/app\.chengfenmiao\.com\/helper\/VersionCheck\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/app\.chengfenmiao\.com\/item\/closet\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/app\.chengfenmiao\.com\/Helper\/HotWords\? data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/app\.chengfenmiao\.com\/helper\/setting\? 'delpaths([["detail_buy_sites"],["bottom_sites"]])'

[MITM]
hostname = %APPEND% app.chengfenmiao.com
