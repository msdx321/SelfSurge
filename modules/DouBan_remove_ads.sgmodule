#!name=豆瓣去广告
#!desc=移除开屏广告、各页面信息流广告、首页横幅、搜索填充词。此插件需要IPA签名方可使用，App Store用户请勿使用此插件，务必点击下方主页链接查看详细教程。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id907002334
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://getupnote.com/share/notes/zSn1ShBmzNYISKcTgjXE5oHMrNf2/34bf3aad-7872-497d-b239-198e27e8c84c
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DouBan.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/DouBan_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Map Local]
^https:\/\/api\.douban\.com\/v\d\/app_ads\/splash data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/frodo\.douban\.com\/api\/v\d\/erebor\/feed_ad data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/m\.douban\.com\/rexxar\/api\/v\d\/market\/products\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/frodo\.douban\.com\/api\/v\d\/movie\/ad data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/frodo\.douban\.com\/api\/v\d\/home_banner data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/frodo\.douban\.com\/api\/v\d\/search\/found_words data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% api.douban.com, frodo.douban.com, m.douban.com
