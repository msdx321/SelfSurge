#!name=京东去广告
#!desc=移除京东开屏广告，精简我的页面产品推广。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id414245413
#!author=RuCu6[https://github.com/RuCu6], Maasea[https://github.com/Maasea]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/JD_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
URL-REGEX, "^http:\/\/\w{32}\.jddebug\.com\/diagnose\?", REJECT-DROP

[Map Local]
^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06]) data-type=text data="{}" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig 'reduce [[["data","JDMessage","socketmonitor","isSocketEstablishedAhead"],["data","JDMessage","socketmonitor"],"isSocketEstablishedAhead",0],[["data","JDMessage","socketmonitor","isSocketReport"],["data","JDMessage","socketmonitor"],"isSocketReport",0],[["data","JDHttpToolKit","httpdns","httpdns"],["data","JDHttpToolKit","httpdns"],"httpdns",0]][] as $item (.;. as $before | try (if (getpath($item[1]) | has($item[2])) then setpath($item[0];$item[3]) else . end) catch $before)'

[Script]
移除京东广告 = type=http-response,pattern=^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome),script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/JD/JD_remove_ads.js,requires-body=true

[MITM]
hostname = %APPEND% api.m.jd.com
