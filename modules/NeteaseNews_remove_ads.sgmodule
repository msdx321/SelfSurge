#!name=网易新闻去广告
#!desc=移除开屏广告、置顶新闻、热搜列表和搜索栏填充词。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id425349261
#!author=RuCu6[https://github.com/RuCu6]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/NeteaseNews.png
#!date=2026-10-02 13:57:49
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/NeteaseNews_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN, nex.163.com, DIRECT
DOMAIN, gw.m.163.com, DIRECT

[Map Local]
(?i)^https?:\/\/interface\.music\.163\.com\/eapi\/ad data-type=text data="" status-code=404
(?i)^https?:\/\/c\.m\.163\.com\/nc\/gl\/ data-type=text data="" status-code=404
(?i)^https?:\/\/client\.mail\.163\.com\/apptrack\/confinfo\/searchMultiAds data-type=text data="" status-code=404
(?i)^https?:\/\/g1\.163\.com\/madfeedback data-type=text data="" status-code=404
(?i)^https?:\/\/interface\.music\.163\.com\/eapi\/ad\/ data-type=text data="" status-code=404
(?i)^https?:\/\/support\.you\.163\.com\/xhr\/boot\/getBootMedia\.json data-type=text data="" status-code=404
(?i)^https?:\/\/interface3?\.music\.163\.com\/eapi\/(ad|abtest|sp|hot|store|search\/(specialkeyword|defaultkeyword|hot)) data-type=text data="" status-code=404

[Script]
移除网易新闻广告 = type=http-response,pattern=(?i)^https:\/\/nex\.163\.com\/q,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/NeteaseNews/NeteaseNews_remove_ads.js,requires-body=true
移除网易新闻广告 2 = type=http-response,pattern=(?i)^https:\/\/gw\.m\.163\.com\/nc\/api\/v1\/feed\/dynamic\/headline-list\?,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/NeteaseNews/NeteaseNews_remove_ads.js,requires-body=true
移除网易新闻广告 3 = type=http-response,pattern=(?i)^https:\/\/gw\.m\.163\.com\/nc\/api\/v1\/search\/hot-word,script-path=https://raw.githubusercontent.com/msdx321/SelfSurge/main/scripts/NeteaseNews/NeteaseNews_remove_ads.js,requires-body=true

[MITM]
hostname = %APPEND% nex.163.com, interface.music.163.com, c.m.163.com, client.mail.163.com, g1.163.com, support.you.163.com, interface3?.music.163.com, gw.m.163.com
