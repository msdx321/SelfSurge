#!name=DREAME去广告
#!desc=移除开屏广告、首页大图推广、横幅推广，精简底栏，阻止桌面图标替换。仅支持2.5.1版。
#!category=去广告
#!openUrl=https://apps.apple.com/app/id1564419343
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DREAME.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/DREAME_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Map Local]
^https:\/\/cn\.iot\.dreame\.tech:\d+\/dreame-product\/public\/advertisement\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/cn-mall\.dreame\.tech\/dreame-mall\/api\/v1\/tag\/list$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/cn-wxmall\.dreame\.tech\/main\/goods\/get-topgoods$ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/cn\.iot\.dreame\.tech:\d+\/dreame-product\/public\/common-plugin$ data-type=base64 data="" header="Content-Type:application/json" status-code=200

[Body Rewrite]
http-response-jq ^https:\/\/cn\.iot\.dreame\.tech:13267\/dreame-system\/dreame-app\/setting\/query$ 'reduce [["data","appIconConfig"]][] as $path (.;. as $before | try delpaths([$path]) catch $before)'

[MITM]
hostname = %APPEND% cn-mall.dreame.tech, cn-wxmall.dreame.tech, cn.iot.dreame.tech
