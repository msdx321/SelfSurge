#!name=微信公众号去广告
#!desc=过滤微信公众号广告
#!category=去广告
#!openUrl=https://apps.apple.com/app/id414478124
#!author=RuCu6[https://github.com/RuCu6]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weixin.png
#!date=2026-06-01 17:11:35
#!requirement=CORE_VERSION>=20

# Source: https://kelee.one/Tool/Loon/Lpx/Weixin_Official_Accounts_remove_ads.lpx
# Adapted from Loon LPX to Surge module by SelfSurge.
# Upstream LPX license: CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/

[Rule]
DOMAIN-SUFFIX, wxs.qq.com, REJECT-DROP

[Map Local]
^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword data-type=text data="{}" header="Content-Type:application/json" status-code=200

[MITM]
hostname = %APPEND% mp.weixin.qq.com
